---
---

<div
  class="accessibility-container fixed bottom-4 right-4 flex flex-col items-end gap-3 z-50 transition-opacity duration-300"
>
  
  <div
    id="accessibility-options"
    class="hidden flex-row gap-2 items-center bg-black/90 backdrop-blur-sm shadow-xl p-3 rounded-full border border-gray-800 transition-all duration-300 origin-bottom-right"
    role="region"
    aria-label="Text size controls"
  >
    
    <button
      id="decrease-font"
      class="p-2 w-10 h-10 flex items-center justify-center bg-gray-800 text-white rounded-full hover:bg-gray-700 transition disabled:opacity-50 disabled:cursor-not-allowed group relative"
      aria-label="Decrease text size"
      title="Decrease text size"
    >
      <iconify-icon icon="mdi:format-font-size-decrease" width="20" height="20"></iconify-icon>
      
      <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition whitespace-nowrap pointer-events-none">
        Smaller
      </span>
    </button>

    
    <button
      id="reset-font"
      class="w-14 h-10 flex items-center justify-center bg-gray-800 text-primary font-bold text-sm rounded-full hover:bg-gray-700 transition group relative"
      aria-label="Reset text size"
      title="Reset text size"
    >
      <span id="current-size-display">100%</span>
      
      <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition whitespace-nowrap pointer-events-none">
        Reset
      </span>
    </button>

    
    <button
      id="increase-font"
      class="p-2 w-10 h-10 flex items-center justify-center bg-gray-800 text-white rounded-full hover:bg-gray-700 transition disabled:opacity-50 disabled:cursor-not-allowed group relative"
      aria-label="Increase text size"
      title="Increase text size"
    >
      <iconify-icon icon="mdi:format-font-size-increase" width="20" height="20"></iconify-icon>
      
      <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition whitespace-nowrap pointer-events-none">
        Bigger
      </span>
    </button>
  </div>

  
  <button
    id="toggle-accessibility"
    class="p-3 bg-black text-primary rounded-full shadow-2xl hover:bg-gray-900 border border-yellow-400/30 transform hover:scale-110 transition-all duration-300"
    aria-label="Open accessibility options"
    aria-expanded="false"
  >
    <iconify-icon
      icon="el:universal-access"
      width="34"
      height="34"
      class="text-yellow-400"
    ></iconify-icon>
  </button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleButton = document.getElementById("toggle-accessibility");
    const options = document.getElementById("accessibility-options");
    const increaseBtn = document.getElementById("increase-font");
    const decreaseBtn = document.getElementById("decrease-font");
    const resetBtn = document.getElementById("reset-font");
    const display = document.getElementById("current-size-display");
    const html = document.documentElement;

    
    const steps = [100, 110, 120, 130, 140, 150];
    let currentIndex = 0;

    
    const savedSize = localStorage.getItem("font-size-percent");
    if (savedSize) {
      const size = parseInt(savedSize, 10);
      const foundIndex = steps.indexOf(size);
      if (foundIndex !== -1) {
        currentIndex = foundIndex;
      }
    }
    
    
    updateSize();

    
    toggleButton?.addEventListener("click", () => {
      const isHidden = options?.classList.contains("hidden");
      if (isHidden) {
        options?.classList.remove("hidden");
        options?.classList.add("flex");
        toggleButton.setAttribute("aria-expanded", "true");
      } else {
        options?.classList.add("hidden");
        options?.classList.remove("flex");
        toggleButton.setAttribute("aria-expanded", "false");
      }
    });

    
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!target.closest(".accessibility-container")) {
        options?.classList.add("hidden");
        options?.classList.remove("flex");
        toggleButton?.setAttribute("aria-expanded", "false");
      }
    });

    increaseBtn?.addEventListener("click", () => {
      if (currentIndex < steps.length - 1) {
        currentIndex++;
        updateSize();
      }
    });

    decreaseBtn?.addEventListener("click", () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateSize();
      }
    });

    resetBtn?.addEventListener("click", () => {
      currentIndex = 0;
      updateSize();
    });

    function updateSize() {
      const currentSize = steps[currentIndex];
      
      
      html.style.fontSize = `${currentSize}%`;
      if (display) display.textContent = `${currentSize}%`;
      
      
      localStorage.setItem("font-size-percent", currentSize.toString());

      
      if (increaseBtn) increaseBtn.disabled = currentIndex >= steps.length - 1;
      if (decreaseBtn) decreaseBtn.disabled = currentIndex <= 0;
      
      
      if (resetBtn) {
        if (currentIndex === 0) {
            resetBtn.classList.add('opacity-50', 'cursor-default');
        } else {
            resetBtn.classList.remove('opacity-50', 'cursor-default');
        }
      }
    }
  });
</script>
