---
// HeroSection.astro (por ejemplo)
import FormsServices from "./FormsServices.astro";
import Swiper from "./swiper.astro";

const {
  bagroundImage = "https://res.cloudinary.com/driyxelzh/image/upload/v1744252247/banner1_akffxu.jpg",
} = Astro.props;
const { heading = "#1 Roofer for Albany " } = Astro.props;
const { sliders = [] } = Astro.props;
---

<div
  class="relative bg-cover bg-center min-h-[55vh] text-white"
  style={`background-image:url(${bagroundImage})`}
>
  <div class="absolute inset-0 bg-blue-700 opacity-30 z-[1]"></div>

  <div
    class="relative z-[2] flex flex-col lg:flex-row justify-between items-start gap-8 px-6 py-10 lg:px-20"
  >
    <!-- Text Section -->
    <div class="flex-1 min-w-[300px] text-left m-auto text-input-text">
      <h2
        class="text-xl lg:text-2xl font-semibold tracking-wide mb-2 text-primary"
      >
        One Call Does it all!
      </h2>
      <h1 class="text-3xl lg:text-5xl font-bold leading-tight mb-6">
        {heading}
      </h1>

      <ul class="list-none space-y-2 text-lg">
        <li>✅ Nova Solutions</li>
        <li>✅ Made in USA - Family Owned & Operated</li>
        <li>✅ Transferable Lifetime Warranty</li>
        <li>✅ BBB A+ Accredited</li>
      </ul>

      <div class="mt-6 flex justify-center lg:justify-start">
        <div
          class="w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl"
        >
          <Swiper slides={sliders} />
        </div>
      </div>

      <a
        href="tel:+(518)-598-5156"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center bg-white text-blue-600 hover:text-blue-800 transition-colors font-semibold rounded-lg px-6 py-3 mt-6 shadow-md"
      >
        <iconify-icon icon="material-symbols:call" class="mr-2 text-blue-600"
        ></iconify-icon>
        Call Us
      </a>
    </div>
    <div class="form-box">
      <FormsServices />
    </div>
  </div>
</div>
