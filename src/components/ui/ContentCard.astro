---
interface Props {
  id?: string;
  title: string;
  class?: string;
}

const { id, title, class: className = '' } = Astro.props;
---

<div 
  id={id} 
  class={`bg-white rounded-xl p-8 mb-6 shadow-md border border-gray-200 hover:shadow-xl transition-shadow duration-300 scroll-mt-[120px] ${className}`}
>
  <h3 class="text-xl font-bold text-gray-900 mb-4">{title}</h3>
  <slot />
</div>
