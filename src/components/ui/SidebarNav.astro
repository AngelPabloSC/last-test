---
interface NavLink {
  href: string;
  text: string;
}

interface NavSection {
  title: string;
  links: NavLink[];
}

interface Props {
  sections: NavSection[];
}

const { sections } = Astro.props;
---

<nav class="lg:sticky lg:top-[120px] bg-white rounded-xl p-6 shadow-lg max-h-[calc(100vh-140px)] overflow-y-auto">
  <h3 class="text-lg font-bold text-gray-800 mb-4">Quick Navigation</h3>
  
  {sections.map((section, index) => (
    <div class={index < sections.length - 1 ? 'mb-6' : ''}>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
        {section.title}
      </p>
      <ul class="space-y-2">
        {section.links.map(link => (
          <li>
            <a 
              href={link.href}
              class="block py-2 px-3 text-sm text-gray-600 hover:bg-yellow-50 hover:text-black hover:border-l-primary border-l-3 border-l-transparent rounded-md transition-all duration-200 hover:translate-x-1"
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
