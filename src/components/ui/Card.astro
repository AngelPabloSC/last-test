---
const { title, paragraph, buttonText, url, imageUrl } = Astro.props;
---

<div
  class="group relative w-full max-w-[300px] overflow-hidden rounded-tl-3xl rounded-br-3xl shadow-md transform transition duration-300 hover:scale-[1.03]"
  data-animate="slideInRight"
>
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url('${imageUrl}')`}
  >
  </div>

  <div
    class="absolute inset-0"
    style="background-color: rgba(13, 14, 15, 0.8);"
  >
  </div>

  <div
    class="absolute top-0 left-0 w-full h-[6px] bg-yellow-400 transition-opacity duration-300 group-hover:opacity-0 z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-full h-[6px] bg-yellow-400 transition-opacity duration-300 group-hover:opacity-0 z-10"
  >
  </div>

  <div
    class="relative z-10 p-6 flex flex-col justify-between h-full text-white"
  >
    <div class="mb-4 text-center">
      <h2 class="text-2xl font-bold mb-2">{title}</h2>
      <div class="w-12 h-[2px] bg-white mx-auto mb-4"></div>
      <p class="text-sm leading-relaxed">{paragraph}</p>
    </div>

    <div class="text-center mt-auto">
      <a
        href={url}
        class="inline-block bg-yellow-400 text-blue-900 font-semibold px-4 py-2 mt-4 rounded hover:bg-yellow-300 transition duration-200"
      >
        {buttonText}
      </a>
    </div>
  </div>
</div>
<script>
  import { initStaggeredAnimations } from "../../scripts/scroll-animations";
  
  document.addEventListener("DOMContentLoaded", () => {
    
    initStaggeredAnimations(150);
  });
</script>
