---
const { title = "", message = "" } = Astro.props;
---

<dialog
  id="thank-you-dialog"
  class="rounded-2xl shadow-2xl w-full max-w-md border border-gray-300 backdrop:bg-black/90 backdrop-blur-sm transition-all duration-300 animate-fadeIn text-[var(--color-body-base)] fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50 overflow-hidden relative"
>
  
  <div
    class="absolute inset-0 z-0 bg-center bg-no-repeat bg-contain blur-sm scale-110 bg-black"
    style="background-image: url('https://res.cloudinary.com/driyxelzh/image/upload/v1744936456/Sin_ti%CC%81tulo-2_Mesa_de_trabajo_1_ccks9s.png');"
  ></div>

  
  <div class="relative z-20 p-6 text-center space-y-4">
    
    <h2
      id="dialog-title"
      class={`text-xl font-bold ${title === '¡Registro exitoso!' ? 'text-green-500' : 'text-red-500'}`}
    >
      {title}
    </h2>

    
    <p id="dialog-message" class="text-lg font-medium text-primary">{message}</p>

    
    <button
      id="close-dialog"
      class="mt-2 px-6 py-2 bg-[var(--color-primary)] text-black font-semibold rounded-full shadow hover:bg-[var(--color-primary-600)] transition"
    >
      Close
    </button>
  </div>
</dialog>