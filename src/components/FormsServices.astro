---
import Dialog from "./ Dialog.astro";

const inputStyles =
  "p-3 border border-gray-300 rounded-md text-base bg-white text-black";
const isSuccess = true; // cambia esto dinámicamente si quieres

const title = isSuccess ? "¡Registro exitoso!" : "Error en el registro";
const message = isSuccess
  ? "Gracias por contactarnos. Te llamaremos en el transcurso del día."
  : "Hubo un problema al enviar tu información. Intenta nuevamente.";
---

<div class="form-container w-full max-w-xl mx-auto p-6 bg-primary-second">
  <div
    class="form-header text-start mb-6 uppercase text-4xl font-bold text-input-text text-primary tracking-wider"
  >
    <strong>Contact your local </strong>
    <strong>contractor </strong>
  </div>

  <form id="contact-form" class="flex flex-col space-y-4">
    <input
      type="text"
      id="full-name"
      name="full-name"
      required
      placeholder="Full Name"
      class={inputStyles}
    />

    <input
      type="email"
      id="email"
      name="email"
      required
      placeholder="Email"
      class={inputStyles}
    />

    <input
      type="tel"
      id="phone"
      name="phone"
      required
      placeholder="Phone Number"
      class={inputStyles}
    />

    <div class="flex flex-col sm:flex-row gap-4">
      <div class="flex flex-col flex-1">
        <input
          type="text"
          id="address"
          name="address"
          required
          placeholder="Address"
          class={inputStyles}
        />
      </div>
      <div class="flex flex-col flex-1">
        <input
          type="text"
          id="city"
          name="city"
          required
          placeholder="City"
          class={inputStyles}
        />
      </div>
    </div>

    <textarea
      id="project"
      name="project"
      rows="4"
      required
      placeholder="Tell us about your project..."
      class={`${inputStyles} resize-none`}></textarea>
    <div class="terms-check">
      <label>
        <input type="checkbox" name="accept-terms" required />
        I accept the <a href="/privacy-policy" target="_blank"
          >Terms and Conditions</a
        >
      </label>
    </div>

    <button
      type="submit"
      class="p-2 bg-[var(--color-primary)] text-[var(--color-headline)] rounded text-base transition-all duration-300 hover:bg-[var(--color-primary-second)] hover:text-white"
    >
      Get Free Inspections
    </button>
  </form>
</div>

<style>
  .terms-check {
    font-size: 0.9rem;
    margin-bottom: 15px;
    color: var(--color-input-text);
  }

  .terms-check a {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
<Dialog title={title} message={message} />
<script type="module" src="/scripts/form-handler.js"></script>
