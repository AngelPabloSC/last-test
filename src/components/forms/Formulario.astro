---
import Dialog from "../ui/Dialog.astro";
const isSuccess = true; 

const title = isSuccess ? "¡Registro exitoso!" : "Error en el registro";
const message = isSuccess
  ? "Gracias por contactarnos. Te llamaremos en el transcurso del día."
  : "Hubo un problema al enviar tu información. Intenta nuevamente.";
---

<div class="max-w-[400px] mx-auto p-5 rounded-lg">
  <div
    class="text-end mb-5 uppercase text-[2.5rem] font-light text-[var(--color-input-text)]"
  >
    <strong>Renovations</strong>
    <p class="my-1 text-base font-bold text-[var(--color-input-text)]">
      With us
    </p>
  </div>
  <form id="contact-form" class="flex flex-col">
    <input
      type="text"
      id="full-name"
      name="full-name"
      required
      placeholder="Full Name"
      class="mb-4 p-2 border border-gray-300 rounded bg-white text-base"
    />
    <input
      type="email"
      id="email"
      name="email"
      required
      placeholder="Email"
      class="mb-4 p-2 border border-gray-300 rounded bg-white text-base"
    />
    <input
      type="tel"
      id="phone"
      name="phone"
      required
      placeholder="Phone Number"
      class="mb-4 p-2 border border-gray-300 rounded bg-white text-base"
    />

    <div class="flex gap-4 mb-4">
      <div class="flex-1">
        <input
          type="text"
          id="address"
          name="address"
          required
          placeholder="Address"
          class="w-full p-2 border border-gray-300 rounded bg-white text-base"
        />
      </div>
      <div class="flex-1">
        <input
          type="text"
          id="city"
          name="city"
          required
          placeholder="City"
          class="w-full p-2 border border-gray-300 rounded bg-white text-base"
        />
      </div>
    </div>

    <textarea
      id="project"
      name="project"
      rows="4"
      required
      placeholder="Tell us about your project..."
      class="mb-4 p-2 border border-gray-300 rounded bg-white text-base"
    ></textarea>

    <div class="mb-4 text-sm text-[var(--color-input-text)]">
      <label class="flex items-start gap-2">
        <input type="checkbox" name="accept-terms" required class="mt-1" />
        I accept the
        <a
          href="/privacy-policy"
          target="_blank"
          class="text-[var(--color-primary)] underline">Terms and Conditions</a
        >
      </label>
    </div>

    <button
      type="submit"
      id="submit-button"
      class="p-2 bg-[var(--color-primary)] text-[var(--color-headline)] rounded text-base transition-all duration-300 hover:bg-[var(--color-primary-second)] hover:text-white flex items-center justify-center gap-2"
    >
      <span id="button-text">Get Free Inspections</span>
      <iconify-icon
        id="button-spinner"
        icon="line-md:loading-twotone-loop"
        class="hidden"
        width="24"
        height="24"
      ></iconify-icon>
    </button>
  </form>
</div>

<Dialog title={title} message={message} />
<script>
  import "../../scripts/form-handler.ts";
</script>
