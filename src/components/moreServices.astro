---
// Importar servicios
import { service } from "../data/services";

// Definir props
export interface Props {
  title?: string;
}

const { title = "Explore More Services" } = Astro.props;
---

<section class="mt-20 px-16 max-w-7xl mx-auto mb-10 justify-center">
  <h2
    class="text-2xl font-bold text-black mb-6 text-center lg:text-left text-transparent bg-clip-text bg-gradient-to-br from-black from-20% via-primary via-60% to-black"
 
  >
    {title}
  </h2>
  <section
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"
  >
    {
      service.map((item) => (
        <a
          href={item.path}
          class="block p-4 rounded-xl border shadow hover:shadow-lg"
        >
          <span
            class="text-lg text-black mb-1 text-transparent bg-clip-text bg-gradient-to-br from-black from-20% via-primary via-90% to-black"
           
          >
            {item.title}
          </span>
          <p class="text-sm text-black">{item.description}</p>
        </a>
      ))
    }
  </section>
</section>
