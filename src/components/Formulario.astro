---

---

<div class="form-header">
  <strong>Renovations</strong>
  <p>With us</p>
</div>
<form>
  <input
    type="text"
    id="full-name"
    name="full-name"
    required
    placeholder="Full Name"
  />

  <input type="email" id="email" name="email" required placeholder="Email" />

  <input
    type="tel"
    id="phone"
    name="phone"
    required
    placeholder="Phone Number"
  />

  <div class="stack-row">
    <div class="input-group">
      <input
        type="text"
        id="address"
        name="address"
        required
        placeholder="Address"
      />
    </div>
    <div class="input-group">
      <input type="text" id="city" name="city" required placeholder="City" />
    </div>
  </div>

  <textarea
    id="project"
    name="project"
    rows="4"
    required
    placeholder="Tell us about your project..."></textarea>
  <div class="terms-check">
    <label>
      <input type="checkbox" name="accept-terms" required />
      I accept the <a href="/privacy-policy" target="_blank"
        >Terms and Conditions</a
      >
    </label>
  </div>

  <button type="submit">Get Free Inspections</button>
</form>

<style>
  .form-container {
    max-width: 400px;
    margin: 0 auto;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .form-header {
    text-align: end;
    margin-bottom: 20px;
    text-transform: uppercase;
    font-size: 2.5rem;
    font-weight: lighter;
    color: var(--color-input-text);
  }

  .form-header p {
    margin: 5px 0;
    font-size: 1rem;
    font-weight: bold;
    color: var(--color-input-text);
  }

  form {
    display: flex;
    flex-direction: column;
  }

  label {
    margin-bottom: 5px;
    font-weight: bold;
  }

  input,
  textarea {
    margin-bottom: 15px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
  }

  button {
    padding: 10px;
    background-color: var(--color-primary); /* Amarillo #FFEC00 */
    color: var(--color-headline);
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease; /* Suaviza el cambio de color */
  }

  button:hover {
    background-color: var(--color-primary-second); /* Azul medio #424769 */
    color: white;
  }
  .stack-row {
    display: flex;
    gap: 1rem; /* Espacio entre Address y City */
    flex-wrap: wrap; /* Para que sea responsive */
  }

  .input-group {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 200px; /* Para que no se achiquen mucho */
  }
  input,
  textarea {
    background-color: white;
    /* resto de estilos... */
  }
  .terms-check {
    font-size: 0.9rem;
    margin-bottom: 15px;
    color: var(--color-input-text);
  }

  .terms-check a {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
