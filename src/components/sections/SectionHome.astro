---
import Formulario from "../forms/Formulario.astro";
import { Icon } from "astro-icon/components";
---

<div
  id="slideshow-container"
  class="relative transition-all duration-1000 min-h-[55vh] h-auto"
>
  <img
    id="hero-image"
    src="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1746726907/IMG-20240109-WA0138_y93nsn.jpg"
    srcset="
      https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_800/v1746726907/IMG-20240109-WA0138_y93nsn.jpg 800w,
      https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1746726907/IMG-20240109-WA0138_y93nsn.jpg 1920w
    "
    sizes="(max-width: 768px) 800px, 1920px"
    alt="Hero Background"
    class="absolute inset-0 w-full h-full object-cover -z-10"
    fetchpriority="high"
  />

  <div
    class="absolute inset-0 bg-gradient-to-tr from-black via-black/80 to-transparent opacity-100 z-[1]"
  >
  </div>

  <div
    class="relative z-[2] flex text-primary flex-wrap justify-between items-center p-10 h-full"
  >
    
    <div class="flex-1">
      <section class="px-4 md:px-10 lg:px-[10%]">
        <h1 class="text-4xl sm:text-4xl md:text-6xl mb-2 text-primary-700">
          One Team. One Vision. Your Dream.
        </h1>
        <h1 class="text-3xl sm:text-4xl md:text-5xl mb-5 text-white">
          Commercial and Residential
        </h1>
        <h2
          class="text-lg sm:text-2xl mb-4 underline decoration-double text-white italic font-bold"
        >
          One Call Does it All!
        </h2>

        <p
          class="mt-5 text-sm sm:text-base text-yellow-400"
        >
          4.5★★★★★ | Google Reviews
        </p>
      </section>

      <div>
        <p
          class="ml-[10%] mt-3 my-1 px-3 py-3 text-lg font-bold bg-blue-500 text-white rounded-lg inline-block hover:bg-blue-700 transition-colors"
        >
          <Icon
            name="mdi:phone"
            width="32"
            height="32"
            class="inline-block mr-1"
          />
          <strong>+1 518-598-5156</strong>
        </p>
      </div>
    </div>

    
    <div
      class="hidden md:block min-w-[200px] bg-transparent p-5 rounded-lg shadow-lg mx-20"
    >
      <div class="form-box text-black">
        <Formulario />
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const images = [
    "https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1746726907/IMG-20240109-WA0156_pmbfsw.jpg",
    "https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1746726907/IMG-20240313-WA0043_knl337.jpg",
    "https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1746726907/IMG-20240109-WA0138_y93nsn.jpg",
  ];

  let index = 0;
  
  
  
  
  
  
  index = 2; 

  const heroImg = document.getElementById("hero-image");

  setInterval(() => {
    index = (index + 1) % images.length;
    if (heroImg) {
      
      heroImg.removeAttribute("srcset");
      heroImg.src = images[index];
    }
  }, 5000); 
</script>
