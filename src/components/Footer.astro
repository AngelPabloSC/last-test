---
import { footer } from "../data/footter.ts";
const cloudinaryImage =
  "https://res.cloudinary.com/driyxelzh/image/upload/v1756943631/PHOTO-2025-09-03-18-52-30_mgqq4o.jpg";
const googleMapsUrl = "https://maps.app.goo.gl/QoNHzw2ME7cze2Br5";
---

<footer
  class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 text-white bg-primary-second p-10 pl-10 md:pl-30"
>
  {
    footer.map((item, index) => {
      if (item.type === "contact") {
        return (
          <div class="col-span-2 md:col-span-1 lg:col-span-2 mr-0 md:mr-10">
            <h3 class="font-bold text-xl">{item.tile}</h3>
            <p>{item.number}</p>
            <p>{item.direction}</p>
            <div class="relative w-full max-w-xl h-30 rounded overflow-hidden shadow-lg group">
              <a
                href={googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Abrir ubicación en Google Maps"
                class="absolute inset-0 z-10"
              />

              <img
                src={cloudinaryImage}
                alt="520 Warren St, Albany NY"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
          </div>
        );
      }

      if (item.type === "offices") {
        return (
          <div>
            <h3 class="font-bold text-xl">{item.tile}</h3>
            <ul>
              {item.offices.map((office) => (
                <li>
                  <a href={office.link} class="hover:underline">
                    {office.direction}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      }

      if (item.type === "section") {
        return (
          <div>
            <h3 class="font-bold text-xl flex gap-2 items-center">
              {item.icon && <iconify-icon icon={item.icon} />}
              {item.title}
            </h3>
            <ul class="mt-2 ">
              {item.services.map((service) => (
                <li>
                  <a href={service.link} class="hover:underline text-sm">
                    {service.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      }
    })
  }
</footer>
<div
  class="bg-black text-white text-center py-4 text-sm flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2"
>
  <span class="text-primary">© All rights reserved by Nova Solutions</span>
  <a href="/privacy-policy" class="hover:text-primary">Privacy Policy</a>
</div>
