---
const { gallery, galleryId } = Astro.props;
type GalleryItem = /*unresolved*/ any;
---

<div
  class="gallery"
  data-gallery-id={galleryId}
  data-projects={JSON.stringify(gallery)}
>
  <h1
    class="text-xl sm:text-2xl lg:text-3xl font-bold mb-4 text-center sm:text-left"
  >
    {gallery[0]?.title}
  </h1>

  <!-- Área para swipe -->
  <div class="relative" data-swipe-area>
    <img
      class="mainImage w-full h-[250px] sm:h-[350px] lg:h-[450px] object-cover rounded-lg mb-6"
      src={gallery[0]?.items[0]?.image}
      alt={gallery[0]?.items[0]?.alt}
    />
    <div
      class="absolute top-0 left-0 w-full h-full flex items-center justify-center text-white p-4 sm:p-6"
    >
      <div
        class="flex flex-col justify-end w-full h-full bg-gradient-to-t to-transparent p-4 sm:p-8"
      >
        <h3 class="imageTitle text-lg sm:text-2xl lg:text-3xl font-semibold">
          {gallery[0]?.items[0]?.title}
        </h3>
        <p class="imageDescription mt-2 text-sm sm:text-base lg:text-lg">
          {gallery[0]?.items[0]?.description}
        </p>
      </div>
    </div>

    <!-- Indicador de swipe -->
    <div
      class="swipe-indicator absolute bottom-4 left-0 right-0 text-center text-white font-semibold text-lg"
      id="swipe-indicator"
    >
      <p>Swipe to see more</p>
    </div>
  </div>

  <!-- Miniaturas -->
  <div class="flex gap-3 sm:gap-4 overflow-x-auto no-scrollbar mt-4 sm:mt-6">
    {
      gallery[0]?.items.map((project: GalleryItem, index: number) => (
        <div
          class="thumbnail w-[180px] h-[100px] sm:w-[220px] sm:h-[130px] md:w-[250px] md:h-[150px] flex-shrink-0 bg-cover bg-center rounded-lg relative cursor-pointer"
          style={`background-image: url(${project.image})`}
          data-index={index}
        >
          <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black to-transparent text-white px-2 sm:px-4 py-1 sm:py-2">
            <p class="text-sm sm:text-base font-semibold truncate">
              {project.title}
            </p>
            <p class="text-xs sm:text-sm">{project.date}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script type="module" is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    const galleries = document.querySelectorAll(".gallery");

    galleries.forEach((galleryElement) => {
      const gallery = JSON.parse(galleryElement.dataset.projects);
      let currentImageIndex = 0;
      const totalImages = gallery[0].items.length;
      const mainImage = galleryElement.querySelector(".mainImage");
      const titleElement = galleryElement.querySelector(".imageTitle");
      const descriptionElement =
        galleryElement.querySelector(".imageDescription");
      const thumbnails = galleryElement.querySelectorAll(".thumbnail");
      const swipeArea = galleryElement.querySelector("[data-swipe-area]");
      const swipeIndicator = galleryElement.querySelector("#swipe-indicator");

      function updateMainImage(index) {
        currentImageIndex = index;
        const project = gallery[0].items[currentImageIndex];
        mainImage.src = project.image;
        mainImage.alt = project.alt;
        titleElement.textContent = project.title;
        descriptionElement.textContent = project.description;
      }

      thumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener("click", () => {
          const index = parseInt(thumbnail.dataset.index, 10);
          updateMainImage(index);
          hideSwipeIndicator();
        });
      });

      // 📱 Swipe touch
      let startX = 0;
      let endX = 0;

      swipeArea.addEventListener("touchstart", (e) => {
        startX = e.touches[0].clientX;
      });

      swipeArea.addEventListener("touchend", (e) => {
        endX = e.changedTouches[0].clientX;
        handleSwipe();
      });

      // 🖱️ Mouse drag
      let isDragging = false;
      let mouseStartX = 0;
      let mouseEndX = 0;

      swipeArea.addEventListener("mousedown", (e) => {
        isDragging = true;
        mouseStartX = e.clientX;
      });

      window.addEventListener("mouseup", (e) => {
        if (isDragging) {
          mouseEndX = e.clientX;
          handleMouseSwipe();
          isDragging = false;
        }
      });

      function handleSwipe() {
        const deltaX = endX - startX;
        if (Math.abs(deltaX) > 50) {
          if (deltaX < 0) {
            currentImageIndex = (currentImageIndex + 1) % totalImages;
          } else {
            currentImageIndex =
              (currentImageIndex - 1 + totalImages) % totalImages;
          }
          updateMainImage(currentImageIndex);
          hideSwipeIndicator();
        }
      }

      function handleMouseSwipe() {
        const deltaX = mouseEndX - mouseStartX;
        if (Math.abs(deltaX) > 50) {
          if (deltaX < 0) {
            currentImageIndex = (currentImageIndex + 1) % totalImages;
          } else {
            currentImageIndex =
              (currentImageIndex - 1 + totalImages) % totalImages;
          }
          updateMainImage(currentImageIndex);
          hideSwipeIndicator();
        }
      }

      function hideSwipeIndicator() {
        swipeIndicator.style.display = "none";
      }
    });
  });
</script>
