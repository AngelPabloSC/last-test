---
interface Service {
  title: string;
  path: string;
  icon: string;
}

// Solo necesitas 'title' para el título de sección, no 'titleService'
const { services = [], title = "Related Roofing Services" } = Astro.props as {
  services: Service[];
  title: string;
};
---

<section class="mt-16 px-4 max-w-6xl mx-auto">
  <h2 class="text-2xl font-bold text-primary-700 mb-6 text-center lg:text-left">
    {title}
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      services.map(({ title, path, icon }) => (
        <a
          href={path}
          class="group flex items-center space-x-4 hover:bg-gray-50 p-3 rounded transition"
        >
          <iconify-icon
            icon={icon}
            class="text-2xl sm:text-3xl transition-transform duration-300 group-hover:rotate-6"
          />
          <span class="text-sm sm:text-base font-medium text-gray-700 group-hover:text-primary-700">
            {title}
          </span>
        </a>
      ))
    }
  </div>
</section>