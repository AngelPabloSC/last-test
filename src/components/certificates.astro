---
// FeatureCard.astro
const { title, description, icon } = Astro.props;
---

<div
  class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 ease-in-out p-6 sm:p-8 flex flex-col gap-4 group transform hover:-translate-y-1"
>
  <h3 class="font-bold text-lg sm:text-xl flex gap-3 items-center text-blue-600 group-hover:text-blue-800 transition-colors duration-300">
    {icon && (
      <iconify-icon
        icon={icon}
        class="text-2xl sm:text-3xl transition-transform duration-300 group-hover:rotate-6"
      />
    )}
    {title}
  </h3>
  <p class="text-gray-600 text-sm sm:text-base leading-relaxed text-justify">
    {description}
  </p>
</div>