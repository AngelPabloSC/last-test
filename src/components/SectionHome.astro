---
import Formulario from "./Formulario.astro";
import { Icon } from "astro-icon/components";
---

<div
  id="slideshow-bg"
  class="relative bg-cover bg-center transition-all duration-1000 min-h-[55vh] h-auto bg-position-center"
  style="background-image: url('https://res.cloudinary.com/driyxelzh/image/upload/v1746726907/IMG-20240109-WA0138_y93nsn.jpg')"
>
  <div
    class="absolute inset-0 bg-gradient-to-tr from-black via-black/80 to-transparent opacity-100 z-[1]"
  >
  </div>

  <div
    class="relative z-[2] flex text-primary flex-wrap justify-between items-center p-10 h-full"
  >
    <!-- Contenido principal -->
    <div class="flex-1 animate__animated animate__backInLeft">
      <section class="px-4 md:px-10 lg:px-[10%]">
        <h1 class="text-4xl sm:text-4xl md:text-6xl mb-2 text-primary-700">
          One Team. One Vision. Your Dream.
        </h1>
        <h1 class="text-3xl sm:text-4xl md:text-5xl mb-5 text-white">
          Commercial and Residential
        </h1>
        <h2
          class="text-lg sm:text-2xl mb-4 underline decoration-double text-white italic font-bold"
        >
          One Call Does it All!
        </h2>

        <p
          class="mt-5 text-sm sm:text-base text-yellow-400 animate-slide-in-left"
        >
          4.5★★★★★ | Google Reviews
        </p>
      </section>

      <div>
        <p
          class="ml-[10%] mt-3 my-1 px-3 py-3 text-lg font-bold bg-blue-500 text-white rounded-lg inline-block hover:bg-blue-700 transition-colors"
        >
          <Icon
            name="mdi:phone"
            width="32"
            height="32"
            class="inline-block mr-1"
          />
          <strong>(518)-598-5156</strong>
        </p>
      </div>
    </div>

    <!-- Formulario oculto en móviles -->
    <div
      class="hidden md:block min-w-[200px] bg-transparent p-5 rounded-lg shadow-lg mx-20"
    >
      <div class="form-box text-black animate__animated animate__fadeInDown">
        <Formulario />
      </div>
    </div>
  </div>
</div>

<!-- Información adicional -->

<!-- Script para cambiar fondo -->
<script is:inline>
  const images = [
    "https://res.cloudinary.com/driyxelzh/image/upload/v1746726907/IMG-20240109-WA0156_pmbfsw.jpg",
    "https://res.cloudinary.com/driyxelzh/image/upload/v1746726907/IMG-20240313-WA0043_knl337.jpg",
    "https://res.cloudinary.com/driyxelzh/image/upload/v1746726907/IMG-20240109-WA0138_y93nsn.jpg",
  ];

  let index = 0;
  const bg = document.getElementById("slideshow-bg");

  setInterval(() => {
    index = (index + 1) % images.length;
    if (bg) {
      bg.style.backgroundImage = `url('${images[index]}')`;
    }
  }, 5000); // cambia cada 5 segundos
</script>
