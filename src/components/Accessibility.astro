---

<div
  class="accessibility-container fixed bottom-4 right-4 flex flex-col items-center gap-3 z-3 opacity-60 hover:opacity-100 transition-opacity duration-300"
>
  <!-- Botón de Accesibilidad - Modo de Cambio -->
  <button
    id="toggle-accessibility"
    class="p-4 bg-black text-primary rounded-full shadow-lg transform hover:scale-110 transition-transform duration-300"
  >
    <iconify-icon
      icon="el:universal-access"
      width="34"
      height="34"
      class="text-yellow-400"></iconify-icon>
  </button>

  <div
    id="accessibility-options"
    class="hidden flex-col gap-3 items-center bg-black shadow-lg p-4 rounded-xl max-w-[220px]"
  >
    <button
      id="increase-font"
      class="p-2 bg-gray-200 text-black rounded text-sm hover:bg-gray-300"
    >
      A+
    </button>
    <button
      id="reset-font"
      class="p-2 bg-gray-200 text-black rounded text-sm hover:bg-gray-300"
    >
      A
    </button>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleButton = document.getElementById("toggle-accessibility");
    const options = document.getElementById("accessibility-options");
    const html = document.documentElement;
    const increaseFont = document.getElementById("increase-font");
    const resetFont = document.getElementById("reset-font");

    let fontSizes = ["100%", "120%", "140%"];
    let currentSizeIndex = 0;

    // Cargar preferencia guardada
    const savedSize = localStorage.getItem("font-size");
    if (savedSize) {
      const index = fontSizes.indexOf(savedSize);
      if (index !== -1) {
        currentSizeIndex = index;
        html.style.fontSize = fontSizes[currentSizeIndex];
      }
    }

    // Alternar visibilidad
    toggleButton?.addEventListener("click", () => {
      if (options) {
        options.classList.toggle("hidden");
      }
    });

    // Aumentar tamaño
    increaseFont?.addEventListener("click", () => {
      if (currentSizeIndex < fontSizes.length - 1) {
        currentSizeIndex++;
        html.style.fontSize = fontSizes[currentSizeIndex];
        localStorage.setItem("font-size", fontSizes[currentSizeIndex]);
      }
    });

    // Restaurar tamaño original
    resetFont?.addEventListener("click", () => {
      currentSizeIndex = 0;
      html.style.fontSize = fontSizes[currentSizeIndex];
      localStorage.setItem("font-size", fontSizes[currentSizeIndex]);
    });
  });
</script>
