---
import certificates from "../json/sertificates.json";
---

<h2 class="text-2xl font-bold mb-6 text-left lg:text-center text-black mt-10">
  Certificates 
</h2>
<div
  class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-2 gap-4 justify-items-start lg:justify-items-center align-middle items-center"
>
  {
    certificates.map((item) => (
      <img
        src={item.imgUrl}
        alt={item.alt}
        class="w-auto max-w-[80px] h-auto rounded-xl"
      />
    ))
  }
</div>
