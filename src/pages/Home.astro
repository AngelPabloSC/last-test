---
import Card from "../components/ui/Card.astro";
import SectionHome from "../components/sections/SectionHome.astro";
import Layout from "../layouts/Layout.astro";
import { stepsRespote } from "../data/content/step-restore";
import { oneCall } from "../data/content/onecall";
import LazyYoutube from "../components/media/LazyYoutube.astro";
import Swiper from "../components/media/swiper.astro";
import suppliers from "../json/suppliers.json";
import Footer from "../components/layout/Footer.astro";
import "../styles/animations.css";
const props = Astro.props;
const title = "titleSteps" in stepsRespote[0] ? stepsRespote[0].titleSteps : "";
---

<Layout
  title="Nova Solutions Restoration | Roofing & Siding Experts in Capital Region"
  description="Nova Solutions Restoration provides expert roofing, siding, windows, and gutter services in Capital Region. Trusted by homeowners for top-quality exterior home restoration and protection."
  keywords="roofing, siding, windows, gutters, Capital Region, exterior home restoration, home protection, roofing experts, siding contractors, gutter services, Nova Solutions, Capital Region roofing, home restoration, exterior remodeling, free inspection, roof inspection, free roof inspection, roofing near me"
>
  <div class="mt-[199px] md:mt-[95px]">
    <SectionHome />
  </div>
  <div
    class="flex justify-center items-center bg-primary-second bg-opacity-50 text-white font-sans p-[10px] md:p-[10px]"
    data-animate="slide-up"
  >
    <ul
      class="flex flex-wrap md:flex-row items-center justify-center gap-[10px] md:gap-[80px] p-0 m-0 list-none"
    >
      <li class="flex items-center gap-2 text-lg md:text-2xl">
        <span class="text-[1.5rem] md:text-[2rem] font-bold text-primary"
          >✓</span
        >
        Trusted-home experts!
      </li>
      <li class="flex items-center gap-2 text-lg md:text-2xl">
        <span class="text-[1.5rem] md:text-[2rem] font-bold text-primary"
          >✓</span
        >
        Reliable-Installations!
      </li>
      <li class="flex items-center gap-2 text-lg md:text-2xl">
        <span class="text-[1.5rem] md:text-[2rem] font-bold text-primary"
          >✓</span
        >
        Local - Remodelers!
      </li>
    </ul>
  </div>

  <div
    class="flex relative bg-white overflow-hidden h-auto justify-center items-center"
  >
    <div
      class="absolute top-0 right-0 w-full h-full bg-gray-100 z-0"
      style="clip-path: polygon(100% 0, 100% 100%, 30% 100%)"
    >
    </div>

    <div
      class="relative z-1 justify-center items-center text-primary font-sans p-[20px] md:p-[50px]"
    >
      <div class="text-center" data-animate="fade-in">
        <h1 class="text-4xl font-bold italic text-black mb-4">WHAT WE DO</h1>
        <p class="text-lg italic text-black mb-4">
          Nova Solutions | Capital Region Roofing | Roofers | Siding | Windows | Gutters
          | Gutter Guards
        </p>
      </div>

      <section class="flex flex-wrap justify-center gap-6 p-6 bg-white">
        <Card
          title="ROOFING"
          paragraph="Choose a reliable local roofing company that knows what it takes to keep your Capital Region home protected. Nova Solutions has over 5+ years of roofing excellence!."
          buttonText="Explore Roofing"
          url="/Roofing"
          imageUrl="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_800/v1744252247/banner1_akffxu.jpg"
        />

        <Card
          title="SIDING"
          paragraph="Upgrade the curb appeal of your home with vinyl & fiber cement siding by Nova Solutions! Siding not only protects your home's exterior but adds value to your Capital Region home!"
          buttonText="Explore Siding"
          url="/Siding"
          imageUrl="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_800/v1744406636/banner2_pilov2.jpg"
        />

        <Card
          title="GUTTERS"
          paragraph="Our gutters and gutter guards will keep your Capital Region home protected from water runoff & the elements! Gutter Cap is the leading gutter protection system in North America!"
          buttonText="See Gutters"
          url="/Gutters"
          imageUrl="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_800/v1746726327/IMG-20250505-WA0045_uslnfr.jpg"
        />
      </section>
    </div>
  </div>
  <div
    class="flex flex-col md:flex-row md:items-center bg-primary-second h-auto sm:h-auto md:h-auto xl:h-auto px-10 md:px-20 py-20 md:py-20 gap-10"
  >
    
    <div class="w-full flex flex-col justify-center h-auto" data-animate="slide-up">
      <h1
        class="text-primary text-4xl md:text-5xl font-bold italic mb-4 text-center md:text-left"
      >
        When Disaster Strikes, Call Nova Solutions
      </h1>

      <h2
        class="text-white text-xlarge font-semibold mb-4 text-center md:text-left"
      >
        Trusted Experts in Capital Region
      </h2>

      <p class="text-white text-large leading-relaxed mb-6 text-justify">
        Emergencies can strike anytime, leaving your property in disarray. Nova
        Solutions specializes in flood restoration Capital Region and water damage
        restoration in Capital Region, ensuring quick help when disaster hits. We handle
        mitigation and fire restoration, and more to restore your space swiftly.
        Our experts prioritize safety, efficiency, and quality, so you can
        regain peace of mind. Turn to Nova Solutions for a fast, reliable
        recovery that brings your property back to its best.
      </p>

      <h3 class="text-white font-bold mb-4 text-3xl md:text-4xl text-center">
        Our Restoration Services
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 justify-center">
        <button
          class="text-primary font-semibold px-6 py-4 rounded-xl hover:bg-white hover:text-primary hover:shadow-xl transition duration-200 flex flex-col items-center bg-white/20"
          title="Fire Damage Restoration"
        >
          <iconify-icon icon="mdi:fire" class="text-3xl mb-1"></iconify-icon>
          Fire Damage
        </button>

        <button
          class="text-primary font-semibold px-6 py-4 rounded-xl hover:bg-white hover:text-primary hover:shadow-xl transition duration-200 flex flex-col items-center bg-white/20"
          title="Water Damage Restoration"
        >
          <iconify-icon icon="mdi:water" class="text-3xl mb-1"></iconify-icon>
          Water Damage
        </button>
      </div>
    </div>

    
    <div class="w-full md:w-3/4 flex items-center justify-center h-full" data-animate="fade-in">
      <img
        src="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_800/v1746728328/7C58B497-D953-4A42-9328-A532C4FF5DAB_iwmtiv.png"
        alt="Restoration team working"
        class="rounded-3xl w-[90%] md:w-[60%] h-auto shadow-lg"
        loading="lazy"
        width="800"
        height="600"
      />
    </div>
  </div>
  <div
    class="z-1 relative flex flex-col md:flex-row md:items-center h-auto sm:h-auto md:h-auto xl:h-auto px-10 md:px-20 py-20 md:py-20 gap-10"
  >
    <div
      class="absolute top-0 right-0 w-full h-full bg-gray-100 z-0"
      style="clip-path: polygon(0% 0, 70% 100%, 0% 100%)"
    >
    </div>

    <div class="w-full md:w-1/2 flex flex-col justify-center relative z-10">
      <h2
        class="text-black text-xl md:text-xlarge font-semibold italic mb-4 text-center md:text-left"
      >
        Capital Region’s NY Trusted Roofing & Exterior Specialist
      </h2>

      <h3
        class="text-primary-700 text-xlarge md:text-5xl font-semibold italic mb-4 text-center md:text-left"
      >
        One Call Does It All – Roofing, Siding & More
      </h3>

      <p class="text-black text-lg leading-relaxed mb-6 text-justify">
        At Nova Solutions, we perform both residential and commercial work. If
        you’re looking for a dependable and organized contractor to help with
        your residential or commercial project, give us a call today. We’ll have
        one of our qualified reps work with you to ensure satisfaction every
        step of the way.
      </p>

      <div
        class="flex flex-col-reverse md:flex-col lg:flex-row items-center md:items-start justify-center md:justify-between gap-4 mb-4 my-1 text-center md:text-left"
      >
        <h4 class="text-4xl font-bold">
          About Nova Solutions <span class="block">Restoration</span>
        </h4>
        
      </div>

      <p class="text-black text-lg leading-relaxed mb-6 text-justify">
        <strong>With over 5 years of proven experience </strong> and a dedicated
        team of highly skilled professionals, we specialize in delivering top-quality
        construction and restoration services. Every member of our crew brings <strong
        >
          extensive expertise
        </strong>and a strong commitment to excellence in
        <a
          href="/Roofing"
          class="text-black font-bold hover:text-primary-dark transition"
        >
          roofing
        </a>,
        <a
          href="/Roofing-Repair"
          class="text-black font-bold hover:text-primary-dark transition"
        >
          Roofing Repair,
        </a>
        <a
          href="/Siding"
          class="text-black font-bold hover:text-primary-dark transition"
        >
          siding
        </a>, and
        <a
          href="/Gutters"
          class="text-black font-bold hover:text-primary-dark transition"
        >
          gutter protection.
        </a><strong> At the heart of our work is a promise:</strong> to provide the
        highest level of service, craftsmanship, and customer satisfaction. From
        start to finish, we focus on precision, durability, and attention to detail—ensuring
        every project is completed to the highest standards. When you choose us,
        you’re not just hiring a contractor—you’re partnering with a <strong>
          team that values quality, integrity, and long-lasting results.</strong
        >
      </p>
    </div>

    <div
      class="w-full md:w-3/4 flex items-center justify-center h-full relative z-10 rounded-3xl overflow-hidden"
      data-animate="fade-in"
    >
      <img
        src="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1200/v1746981693/PHOTO-2025-05-11-11-40-19_atlhtq.jpg"
        alt="Ny map services"
        loading="lazy"
        width="1200"
        height="800"
      />
    </div>
  </div>
  <div
    class="relative flex flex-col md:grid md:grid-cols-4 gap-10 min-h-[700px] md:min-h-[auto] overflow-x-hidden overflow-y-visible py-20"
  >
    <div
      class="absolute top-0 right-0 w-full h-full bg-gray-100 z-0"
      style="clip-path: polygon(0% 0, 70% 0, 0% 100%)"
    >
    </div>
    <div class="md:col-span-2 z-[2] pr-4 order-1 pt-0 md:pt-15">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-black mx-9">
        {title}
      </h1>

      {
        stepsRespote.map((item, index) => {
          if ("title" in item && "steps" in item) {
            return (
              <div class="bg-black shadow w-full">
                <button
                  class={`text-primary flex justify-between items-center w-full text-lg font-semibold cursor-pointer accordion-toggle py-4 px-0 md:px-9 ${
                    index !== 1 ? "border-t border-white" : ""
                  }`}
                  data-index={index}
                >
                  <span>{item.title}</span>
                  <span class="transition-transform duration-300 icon">▼</span>
                </button>

                <ul
                  id={`content-${index}`}
                  class="accordion-content list-disc mt-2 px-10 bg-white w-full text-gray-700 text-base md:text-lg overflow-hidden max-h-0 transition-all duration-500 ease-in-out"
                >
                  {item.steps.map((step, stepIndex) => (
                    <li>{step.text}</li>
                  ))}
                </ul>
              </div>
            );
          }
          return null;
        })
      }
    </div>

    <div
      class="md:col-span-2 flex justify-center items-center z-[1] order-2 mt-10 md:mt-0 relative bg-cover bg-center rounded-xl p-0 md:px-20"
    >
      <div
        class="hidden md:block w-full h-[600px] bg-cover bg-center rounded-xl"
        style="background-image: url('https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1000/v1746726355/IMG-20250508-WA0026_vlclqo.jpg')"
      >
      </div>
    </div>
  </div>
  <section class="bg-cover bg-center py-20 bg-primary-second">
    
    <div class="text-center mb-12">
      {
        oneCall.map((item) => {
          if ("titleOneCall" in item) {
            return (
              <h1 class="text-5xl font-bold text-primary">
                {item.titleOneCall}
              </h1>
            );
          }
          if ("subtitleOneCall" in item) {
            return (
              <h2 class="text-2xl italic mt-2 text-white">
                {item.subtitleOneCall}
              </h2>
            );
          }
        })
      }
    </div>

    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-10">
      <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-6">
        {
          oneCall.map((item) => {
            if ("title" in item && "content" in item) {
              return (
                <div class="text-center flex flex-col items-center gap-2 text-primary text-sm">
                  <iconify-icon
                    icon={item.content[0].icon}
                    class="text-yellow-400 text-4xl"
                  />
                  <h3 class="text-lg font-bold uppercase">{item.title}</h3>
                  <p class="text-white text-justify">{item.content[0].text}</p>
                </div>
              );
            }
            return null;
          })
        }
      </div>

      
    </div>
  </section>
  <div
    id="tour-section"
    class="px-4 md:px-20 py-30 bg-cover bg-center transition-all duration-700 ease-in-out h-auto md:h-[600px] justify-center items-center"
    style="background-image: url('https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1744252247/banner1_akffxu.jpg');"
  >
    <h1 class="text-3xl font-bold text-center mb-8 text-white">
      EXPLORE OUR WORK
    </h1>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 max-w-7xl mx-auto"
    >
      <div
        class="bg-white/10 backdrop-blur-md rounded-xl overflow-hidden cursor-pointer transition hover:scale-105 shadow-lg"
        data-bg="https://res.cloudinary.com/driyxelzh/image/upload/v1744252247/banner1_akffxu.jpg"
      >
        <img
          src="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_600/v1744252247/banner1_akffxu.jpg"
          class="w-full h-64 object-cover"
          alt="Roofing Nova Solutions Gallery"
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="p-4 text-white">
          <h2 class="font-bold text-lg">Roofing</h2>
          <p class="text-sm opacity-80">Recent roofing projects.</p>
        </div>
      </div>

      <div
        class="bg-white/10 backdrop-blur-md rounded-xl overflow-hidden cursor-pointer transition hover:scale-105 shadow-lg"
        data-bg="https://res.cloudinary.com/driyxelzh/image/upload/v1744406636/banner2_pilov2.jpg"
      >
        <img
          src="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_600/v1744406636/banner2_pilov2.jpg"
          class="w-full h-64 object-cover"
          alt="Siding Nova Solutions gallery"
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="p-4 text-white">
          <h2 class="font-bold text-lg">Siding</h2>
          <p class="text-sm opacity-80">Durable siding projects .</p>
        </div>
      </div>

      

      <div
        class="bg-white/10 backdrop-blur-md rounded-xl overflow-hidden cursor-pointer transition hover:scale-105 shadow-lg"
        data-bg="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1000/v1746726327/IMG-20250505-WA0045_uslnfr.jpg"
      >
        <img
          src="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_600/v1746726327/IMG-20250505-WA0045_uslnfr.jpg"
          class="w-full h-64 object-cover"
          alt="Gutter Replacement"
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="p-4 text-white">
          <h2 class="font-bold text-lg">Gutters</h2>
          <p class="text-sm opacity-80">Clean gutter finishes.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center flex flex-col bg-white p-5 md:px-10 gap-20 py-20">
    <h1 class="text-2xl font-semibold text-black">
      We use only top-quality products from leading suppliers
    </h1>
    <div class="h-10 w-full flex justify-center items-center">
      <Swiper slides={suppliers} />
    </div>
  </div>
  <div>
    <Footer />
  </div>
  
</Layout>
<script type="module" is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    const toggles = document.querySelectorAll(".accordion-toggle");

    toggles.forEach((button) => {
      button.addEventListener("click", () => {
        const index = button.getAttribute("data-index");
        const content = document.getElementById(`content-${index}`);
        const icon = button.querySelector(".icon");

        const isOpen =
          content.style.maxHeight && content.style.maxHeight !== "0px";

        
        document.querySelectorAll(".accordion-content").forEach((el) => {
          el.style.maxHeight = null;
          el.previousElementSibling
            .querySelector(".icon")
            .classList.remove("rotate-180");
        });

        
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + "px";
          icon.classList.add("rotate-180");
        }
      });
    });
  });
  
  window.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("tour-section");
    const cards = document.querySelectorAll("[data-bg]");

    
    const bgImages = Array.from(cards).map((card) =>
      card.getAttribute("data-bg")
    );

    let current = 0;

    setInterval(() => {
      current = (current + 1) % bgImages.length;
      section.style.backgroundImage = `url('${bgImages[current]}')`;
    }, 5000);
  });
</script>

<script>
  import { initScrollAnimations } from "../scripts/scroll-animations";
  
  document.addEventListener("DOMContentLoaded", () => {
    initScrollAnimations();
  });
</script>

