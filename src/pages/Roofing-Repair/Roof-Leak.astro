---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";
import BuutonMovil from "../../components/ButtonMovil.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import { LinkServicesRoofingRepair } from "../../data/LinkServicesRoffingRepair";
---

<Layout
  title="Roof Leak Repair in Albany | Nova Solution"
  description="Professional roof leak repair services in Albany by Nova Solution. We fix shingle damage, storm impact, and more. Free inspections available."
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[130px] md:mt-[95px]">
  <SectionInfo heading={"Roof Leak"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Roofing-Repair" class="hover:text-primary">Roofing Repair</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Roof Leak</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Leaking Roof Repair Services in Albany
      </h1>

      <p class="text-black leading-relaxed mb-4">
        At <strong>Nova Solution </strong>, we repair all types of leaking roof
        issues throughout Albany. If you've noticed a roof leak, there can be
        multiple causes—and we’re equipped to fix them all. Whether it's weather
        damage or missing shingles, our expert roofers are ready to restore your
        roof to full strength.
      </p>

      <p class="text-black leading-relaxed mt-4">
        Our <strong> crew also fixes deeper roof </strong>issues with precision.
        From flashing problems to past installation mistakes, we’ll ensure your
        leak is gone for good.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<!-- Sección 2: Imagen a la izquierda + texto -->
<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        What You Can Look Forward To:
      </h2>

      <ul class="list-disc list-inside text-black space-y-2">
        <li>
          <strong>Missing shingle repair:</strong> We fix roofing leaks due to absent,
          shattered, or aged shingles.
        </li>
        <li>
          <strong>Weather repair:</strong> No Albany storm can defeat our roofing
          contractors! We repair storm-damaged roofs, missing shingles, and debris-related
          issues.
        </li>
        <li>
          <strong>Hail repair:</strong> Even small hail can damage your shingles.
          If you spot hail damage, we’re ready to help.
        </li>
        <li>
          <strong>Heavy wind damage:</strong> When strong winds strike, your roof
          can suffer. We restore wind-damaged roofs fast.
        </li>
        <li>
          <strong>Roof leak repair and maintenance:</strong> We identify and repair
          roof leaks of all kinds throughout Albany.
        </li>
        <li>
          <strong>Insurance-covered repairs:</strong> We work with your home insurance
          provider to simplify the claims process.
        </li>
        <li>
          <strong>Poor shingle installation:</strong> Improper flashing or installation
          around vents and pipes can lead to leaks—let our professionals fix them
          right.
        </li>
      </ul>

      <p>
        Let us show you why we're the trusted choice for <strong
          >roofing in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-gray-700 mt-4">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices
  title="Related Roofing Services"
  services={LinkServicesRoofingRepair}
/>
<MoreServices />

<Footer />
