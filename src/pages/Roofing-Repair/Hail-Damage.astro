---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";
import { LinkServicesRoofingRepair } from "../../data/LinkServicesRoffingRepair";
import BuutonMovil from "../../components/ButtonMovil.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
---

<Layout
  title="Hail Damage Roof Repair in Albany | Nova Solution"
  description="Fast, reliable hail damage roof repair in Albany, NY by Nova Solution. Free estimates, insurance support, and expert service."
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[130px] md:mt-[95px]">
  <SectionInfo heading={"Hail Damage"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Roofing-Repair" class="hover:text-primary">Roofing Repair</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Hail Damage</span>
  </div>
  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-2xl font-bold text-black mt-10">
        Hail Damage Repair in Albany, NY
      </h1>
      <p class="text-black leading-relaxed mt-4">
        Our Albany hail damage repair experts at <strong>Nova Solution</strong> are
        highly trained, fully insured, and bonded to handle even the toughest storm
        damage cases.
      </p>
      <p class="text-black leading-relaxed mt-4">
        If you need fast and affordable <strong
          >roof repair after hail in Albany</strong
        >, trust the professionals at Nova Solution. Our team of experienced
        roofing repair specialists is ready to serve you with care and
        precision. Our goal is to ensure your roofing repair process is
        stress-free, competitively priced, and completed quickly.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-xl font-semibold text-black mt-10">
      Stress-Free Hail Damage Roof Repair with Insurance Support
    </h2>
    <p class="text-black leading-relaxed mt-4">
      We work with all home and roofing insurance providers to ensure you have a
      smooth, insurance-covered roof repair experience!
    </p>
    <p class="text-black leading-relaxed mt-4">
      To get a <strong>free estimate</strong> for your hail damage roof repair, contact
      <strong>Nova Solution</strong> in Albany today at <strong
        >(518)-598-5156</strong
      >.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<!-- Sección 2: Imagen a la izquierda + texto -->
<section class="max-w-auto mx-auto px-4 my-16 grid 8 items-center">
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
</section>

<TrustOur />
<RelationServices
  title="Related Roofing Services"
  services={LinkServicesRoofingRepair}
/>
<MoreServices />

<Footer />
