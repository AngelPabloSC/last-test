---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";

import BuutonMovil from "../../components/ButtonMovil.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import { LinkServicesRoofingRepair } from "../../data/LinkServicesRoffingRepair";
---

<Layout
  title="Roof Inspection in Albany | Nova Solution"
  description="Get a professional roof inspection in Albany with Nova Solution. We provide post-storm, hail damage, and insurance-related roofing inspections with free estimates."
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[130px] md:mt-[95px]">
  <SectionInfo heading={"Roof Inspection"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Roofing-Repair" class="hover:text-primary">Roofing Repair</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Roof Inspection</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h2 class="text-2xl font-bold text-black mt-10">
        Albany Roof Inspection Services
      </h2>
      <p class="text-black leading-relaxed mt-4">
        At <strong>Nova Solution</strong>, our <strong
          >Albany roofing inspectors</strong
        > offer a comprehensive range of roof inspection services to ensure the durability
        of your roof:
      </p>
      <ul class="list-disc list-inside text-gray-700 space-y-2 mt-4">
        <li><strong>Post-storm roofing inspection</strong></li>
        <li><strong>Hail damage inspection</strong></li>
        <li><strong>Insurance repair estimates</strong></li>
        <li>
          <strong>Roofing penetration checks</strong> (chimneys, flashing, and troughs)
        </li>
      </ul>
      <p class="text-black leading-relaxed mt-4">
        If you're looking for expert <strong
          >roofing inspections in Albany</strong
        >, call us or request a <strong>free estimate</strong> today. Our team will
        ensure your roof is thoroughly inspected and well-maintained for optimal
        performance, giving you peace of mind knowing your home is safe and secure.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-black">
      Why Choose Nova Solutions for Albany Roof Inspection
    </h2>
    <p class="text-black leading-relaxed mt-4">
      Installing or repairing your roof is a significant investment in
      protecting your home. Your roof keeps you safe from storms, high winds,
      fire, and other extreme weather events. Given the importance of your
      roofing system, it's essential to work with the best <strong
        >roofing inspectors in Albany</strong
      > to assess your roof’s needs.
    </p>
    <p class="text-black leading-relaxed mt-4">
      Ready to get a <strong>free inspection</strong> or have questions? Our experts
      at <strong>Nova Solution</strong> are here to help! Call us today to schedule
      a <strong>shingle inspection</strong> and receive a no-obligation estimate.
      Let us help ensure your roof is in top condition to protect your home.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<section class="mx-auto px-4 my-16 grid gap-8 items-center">
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<TrustOur />

<RelationServices
  title="Related Roofing Services"
  services={LinkServicesRoofingRepair}
/>
<MoreServices />

<Footer />
