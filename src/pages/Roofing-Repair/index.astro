---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";

import BuutonMovil from "../../components/ButtonMovil.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import { LinkServicesRoofingRepair } from "../../data/LinkServicesRoffingRepair";
---

<Layout
  title="Roofing Repair in Albany, NY | Nova Solutions"
  description="Get expert roof repair services in Albany, NY. Nova Solutions offers fast, reliable fixes for asphalt shingles, metal roofs, and storm damage. Free inspections available."
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[130px] md:mt-[95px]">
  <SectionInfo heading={"Roofing Repair for Albany"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Roofing Repair</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Expert Roof Repair Services in Albany, NY – Nova Solutions
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        A safe, secure home in Albany starts with a reliable roof. At <strong
          >Nova Solutions</strong
        >, we offer top-tier <strong>roof repair services in Albany, NY</strong>
        to protect your home from Upstate New York’s harsh weather. Many homeowners
        don’t think about their roofs until damage appears—but proactive maintenance
        ensures long-term performance and peace of mind.
      </p>

      <p class="text-black leading-relaxed text-justify mt-4">
        Whether you need a quick patch after a storm or a full structural
        repair, our licensed roofing experts bring over <strong
          >20 years of experience</strong
        > in fixing <strong>asphalt shingles</strong>, restoring <strong
          >metal roofs</strong
        >, and handling emergency repairs across Albany and the Capital Region.
      </p>

      <p class="text-black leading-relaxed text-justify mt-4">
        As a locally trusted name in roofing, <strong>Nova Solutions</strong> is
        committed to excellence, using only the highest quality materials and delivering
        unmatched craftsmanship. Our five-star reviews from Albany homeowners reflect
        the professionalism and care we bring to every project.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-black">
      Greater Albany Roofing Repair for Your Home
    </h2>

    <p class="text-black leading-relaxed text-justify mt-4">
      When you trust <strong>Nova Solutions</strong> with your <strong
        >roof repair in Albany, NY</strong
      >, you can count on personalized service from the first inspection to the
      final nail. We know how important it is for homeowners to be informed
      every step of the way, which is why our team keeps you updated throughout
      the entire roofing process—ensuring you get results that exceed
      expectations.
    </p>

    <p class="text-black leading-relaxed text-justify mt-4">
      Our expert roofers specialize in the repair and replacement of <strong
        >asphalt roofs</strong
      >, <strong>metal roofs</strong>, <strong>rubber roofing (EPDM)</strong>, <strong
        >cedar shake shingles</strong
      >, and more. Whether we’re fixing storm damage or installing a new roofing
      system, we never cut corners. Your roof is built to last with premium
      materials and craftsmanship you can trust.
    </p>

    <p class="text-black leading-relaxed text-justify mt-4">
      Choosing <strong>Nova Solutions of Albany</strong> means choosing long-term
      value, integrity, and roofing excellence. Some of the key benefits of working
      with our trusted <strong>Albany roofing professionals</strong> include:
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<!-- Sección 2: Imagen a la izquierda + texto -->
<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        What You Can Look Forward To:
      </h2>
      <p>
        <ul class="list-disc list-inside text-gray-700 space-y-2">
          <li>
            <strong>A Great Looking Home:</strong> Your roof repairs will be water-tight
            and look great, enhancing the curb appeal of your property.
          </li>
          <li>
            <strong>Storm and Wind Protection:</strong> Rest assured knowing your
            home will stand up to the toughest weather conditions Albany has to offer,
            keeping your family safe and dry.
          </li>
          <li>
            <strong>Highest-Quality Shingles:</strong> With years of experience repairing
            roofs across Albany and West Virginia, we use only high-quality materials
            proven to stand the test of time.
          </li>
          <li>
            <strong>Great Energy Efficiency:</strong> A well-repaired roof helps
            insulate your home, reducing energy costs. Trust our expert roof repair
            professionals to boost your energy efficiency.
          </li>
        </ul>
      </p>
      <p>
        Let us show you why we're the trusted choice for <strong
          >roofing in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-gray-700 mt-4">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices
  title="Related Roofing Services"
  services={LinkServicesRoofingRepair}
/>
<MoreServices />

<Footer />
