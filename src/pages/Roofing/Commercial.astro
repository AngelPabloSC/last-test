---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";
import { LinkServices } from "../../data/LinkServicesRoffing";
import BuutonMovil from "../../components/ButtonMovil.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
---

<Layout
  title="Commercial Roofing in Albany | Reliable Flat & Metal Roofing | Nova Solutions"
  description="Get expert commercial roofing in Albany from Nova Solutions. We offer reliable flat, TPO, EDPM, metal, and asphalt roofing systems for businesses. Schedule your inspection today!"
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[130px] md:mt-[95px]">
  <SectionInfo heading={"Commercial Roofing"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Roofing" class="font-semibold hover:text-primary">Roofing</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Commercial</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Albany Commercial Roofing – Reliable Solutions for Your Business
      </h1>
      <p class="text-gray-700 leading-relaxed text-justify">
        As a business owner or property manager in Albany, the last thing you
        want is unexpected roofing issues disrupting your operations. At <strong
          >Nova Solutions</strong
        >, we provide dependable and cost-effective <strong
          >commercial roofing services</strong
        > so you can handle problems quickly and get back to running your business.
      </p>
    </div>
    <section class="flex-1 text-primary">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-semibold text-black mt-6 mb-2">
      Albany’s Trusted Commercial Roofing Company
    </h2>
    <p class="text-black leading-relaxed text-justify">
      At Nova Solutions, we’re the commercial roofing company businesses in
      Albany trust. Highly rated by local business owners and property managers,
      our team is known for delivering top-tier service and long-lasting roofing
      solutions. With a reputation built on reliability and exceptional client
      care, Nova Solutions is here to handle all your commercial roofing needs
      quickly and professionally — so you can focus on running your business,
      not fixing your roof.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<!-- Sección 2: Imagen a la izquierda + texto -->
<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        What to Expect from Our Expert Albany Roofing Installers
      </h2>
      <ul class="list-disc list-inside text-black leading-relaxed">
        <li>
          EDPM and TPO roofing solutions for flat and commercial roofs in Albany
        </li>
        <li>Asphalt roofing systems for businesses and pitched roofs</li>
        <li>
          Metal roofing options, including stone-coated shingles and standing
          seam styles
        </li>
        <li>
          Durable and cost-effective flat roofing for Albany commercial
          properties
        </li>
        <li>Elegant slate, natural shake, and tile roofing installations</li>
      </ul>
      <p class="text-black mt-6 leading-relaxed">
        Have questions for our Albany roofing experts? <a
          href="/About/Contact-us"
          class="text-black hover:underline font-bold">Contact Nova Solutions</a
        > today to speak with a knowledgeable team member and schedule your roofing
        consultation.
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices title="Related Roofing Services" services={LinkServices} />
<MoreServices />

<Footer />
