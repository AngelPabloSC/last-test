---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";
import { LinkServices } from "../../data/LinkServicesRoffing";
import BuutonMovil from "../../components/ButtonMovil.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
---

<Layout
  title="Roofing Insurance Claims in Albany | Nova Solutions"
  description="Nova Solutions specializes in roofing insurance claims in Albany. With over 5 years of experience, our skilled team helps homeowners navigate insurance claims for roof repairs and restoration, ensuring quality service and customer satisfaction."
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[130px] md:mt-[95px]">
  <SectionInfo heading={"Insurance Claims​"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Roofing" class="hover:text-primary">Roofing</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black"> Insurance Claims</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Albany Roofing Insurance Claims
      </h1>
      <p class="text-black mt-4 leading-relaxed">
        With over 5 years in business and many team members boasting more than
        7 years of experience in construction and restoration, <strong
          >Nova Solutions</strong
        > is your trusted partner for roofing insurance claims in <strong
          >Albany
        </strong>. Every member of our team is committed to delivering the
        highest quality service, workmanship, and customer care.
      </p>
    </div>
    <section class="flex-1 text-primary">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h3 class="text-xl font-semibold text-black mt-6">Our Focus</h3>
    <p class="text-black mt-4 leading-relaxed">
      Our mission is to provide expert-level craftsmanship and customer service
      to homeowners and property owners in a professional, efficient, and
      knowledgeable way. We know that having a safe, dry, and comfortable home
      or business makes a big difference—and that's what drives our passion for
      restoration.
    </p>
    <p class="text-black mt-4 leading-relaxed">
      From storm damage to leaks and everything in between, our team is here to
      help you navigate your roofing insurance claim. We work directly with
      insurance companies to ensure you get the most value for your restoration
      investment—and we’re here every step of the way.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<!-- Sección 2: Imagen a la izquierda + texto -->
<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h3 class="text-xl font-semibold text-black mt-6">Our Services</h3>
      <p class="text-black mt-4 leading-relaxed">
        Nova Solutions is a fully licensed and insured home improvement company
        offering complete roofing, restoration, and construction services.
        Whether it’s new construction, a remodel, or insurance-related repairs,
        our skilled team can handle it all—residential or commercial.
      </p>

      <p class="text-black mt-4 leading-relaxed">
        Have questions about your Lexington roofing insurance claim? <a
          href="/About/Contact-us"
          class="text-black font-bold hover:underline">Contact us today</a
        > for a free consultation—we’d be happy to inspect your property and walk
        you through the process.
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices title="Related Roofing Services" services={LinkServices} />
<MoreServices />

<Footer />
