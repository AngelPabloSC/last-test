---
import Loyout from "../../layouts/Layout.astro";
import ContactSeccion from "../../components/sections/ContactSeccion.astro";
import { service } from "../../data/content/services";
import Footer from "../../components/layout/Footer.astro";
import Card from "../../components/services/certificates.astro";
import { oneCallExtra } from "../../data/content/services-roofing";
import MoreServices from "../../components/services/moreServices.astro";
---

<Loyout
  title="Contact Us | Nova Solutions"
  description="Nova Solutions is the #1 roofing company for estate and estares. We offer a wide range of roofing services, including roof repair, roof replacement, and roof installation. Our team of experienced professionals is dedicated to providing the highest quality service and workmanship."
  showButtonMovil={false}
>
  <div class="mt-[-50px] md:mt-[125px]">
    <ContactSeccion heading="Contact" />
  </div>

  <div class="max-w-6xl w-full mx-auto px-4">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 items-start justify-items-center sm:justify-items-between gap-4 mb-6"
    >
      <div class="space-y-6 flex flex-col items-center sm:items-start">
        <div class="breadcrumb text-sm flex items-center">
          <a href="/" class="hover:text-gray-700">Home</a>
          <iconify-icon
            icon="mingcute:arrows-right-line"
            class="mx-2 text-gray-400 text-lg"></iconify-icon>
          <span class="font-semibold text-gray-800">Contact Us</span>
        </div>
      </div>
    </div>
  </div>
  <MoreServices />
  <div
    class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-4 px-4 mx-auto max-w-7xl my-10 animate-fade-in"
  >
    {
      oneCallExtra.map((item) => (
        <Card
          title={item.title}
          description={item.content[0].text}
          icon={item.content[0].icon}
        />
      ))
    }
  </div>
  <Footer />
</Loyout>
