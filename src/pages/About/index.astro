---

import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import MoreServices from "../../components/moreServices.astro";
import Trust from "../../components/Trust.astro";
import Container from "../../components/Container.astro";
import Paragraph from "../../components/Paragraph.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import FormsServices from "../../components/FormsServices.astro";
---

<Layout
  title="About Nova Solutions | Roofing & Exterior Experts in Albany, NY"
  description="Discover Nova Solutions, Albany’s trusted provider of roofing, siding, gutters, and exterior home services. With 5+ years of experience, we deliver durable craftsmanship and reliable protection for your home."
/>

<section class="relative pt-32 lg:pt-36 mt-[100px] md:mt-[50px]">
  <Container className={"flex flex-col lg:flex-row gap-10 lg:gap-12"}>
    <div class="absolute w-full lg:w-1/2 inset-y-0 lg:right-0">
      <span
        class="absolute -left-6 md:left-4 top-24 lg:top-28 w-24 h-24 rotate-90 skew-x-12 rounded-3xl bg-green-400 blur-xl opacity-60 lg:opacity-95 lg:block hidden"
      ></span>
      <span
        class="absolute right-4 bottom-12 w-24 h-24 rounded-3xl bg-primary blur-xl opacity-80"
      ></span>
    </div>
    <span
      class="w-4/12 lg:w-2/12 aspect-square from-primary to-yellow-400 absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"
    ></span>
    <div
      class="relative flex flex-col items-center text-center lg:text-left lg:py-7 xl:py-8
      lg:items-start lg:max-w-none max-w-3xl mx-auto lg:mx-0 lg:flex-1 lg:w-1/2"
    >
      <h1
        class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight xl:text-6xl/tight
    font-bold text-heading-1"
      >
        Comprehensive <span
          class="text-transparent bg-clip-text bg-gradient-to-br from-black from-20% via-primary via-30% to-black"
          >Home Exterior Solutions</span
        > by Nova Solutions
      </h1>
      <Paragraph className="mt-8">
        Nova Solutions specializes in roofing, roof repairs, gutters, leaf
        guards, and siding — delivering reliable service and lasting protection
        for your home.
      </Paragraph>
      <div class="mt-10 w-full flex max-w-md mx-auto lg:mx-0">
        <div class="flex sm:flex-row flex-col gap-5 w-full"></div>
      </div>
    </div>

    <div
      class="flex flex-1 lg:w-1/2 lg:h-auto relative lg:max-w-none lg:mx-0 mx-auto max-w-3xl"
    >
      <img
        src="https://res.cloudinary.com/driyxelzh/image/upload/v1744258572/WhatsApp_Image_2025-04-08_at_15.15.18-removebg-preview_1_gbw7ay.png"
        alt="Nova Solutions Logo"
        width="2350"
        height="2359"
        class="lg:absolute lg:w-full lg:h-full rounded-3xl object-cover lg:max-h-none max-h-96"
      />
    </div>
  </Container>
</section>
<div class="max-w-6xl mx-auto my-16">
  <Trust />
  <div
    class="flex flex-col lg:flex-row gap-10 items-center lg:items-start mt-10"
  >
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left">
        About Nova Solutions
      </h1>
      <p class="text-black leading-relaxed text-justify">
        <strong>About Nova Solutions</strong> —
        <strong>Nova Solutions</strong> is a leading provider of
        <strong>exterior home improvement services</strong> in
        <strong>Albany, New York</strong>. With over <strong
          >5 years of hands-on experience</strong
        >, we specialize in <strong>roofing</strong>, <strong
          >roof repair</strong
        >,
        <strong>gutter installation</strong>, <strong>leaf guard systems</strong
        >, and
        <strong>siding replacement</strong>. Our skilled team is dedicated to
        <strong>protecting and enhancing your home</strong> with high-quality craftsmanship,
        durable materials, and dependable service. Whether you’re dealing with
        <strong>storm damage</strong>, looking to <strong
          >boost curb appeal</strong
        >, or need
        <strong>long-term protection</strong> from water and weather,
        <strong>Nova Solutions</strong> is the trusted local expert. We’re proud
        to serve homeowners throughout <strong>Albany</strong> and surrounding areas
        with affordable,
        <strong>customized exterior solutions</strong> that last.
      </p>
    </div>
    <section class="flex-1 text-primary">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <p
      class="text-4xl sm:text-5xl font-bold italic text-center text-transparent bg-clip-text bg-gradient-to-br from-black from-20% via-primary via-30% to-black"
    >
      “Protecting Your Home, One Roof at a Time.”
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744258572/WhatsApp_Image_2025-04-08_at_15.15.18-removebg-preview_1_gbw7ay.png"
    alt="Roofing Installation"
    class="w-full max-w-md mx-auto"
  />
</section>

<MoreServices title="Our Services " />
<div class="w-full px-4 py-8 max-w-7xl mx-auto">
  <h1
    class="text-2xl sm:text-3xl md:text-4xl font-bold text-center text-primary mb-6"
  >
    Where to Find Us
  </h1>
  <div
    class="w-full h-[300px] sm:h-[400px] md:h-[500px] rounded-xl overflow-hidden shadow-lg"
  >
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2934.2836642714856!2d-73.78406582251819!3d42.655343871167084!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89de0a44e842d437%3A0xe0a4d4c58fccc801!2s520%20Warren%20St%2C%20Albany%2C%20NY%2012208!5e0!3m2!1ses-419!2sus!4v1745812732846!5m2!1ses-419!2sus"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="w-full h-full"></iframe>
  </div>
</div>
<section class="bg-primary text-black py-20 px-6 md:px-12">
  <div class="max-w-7xl mx-auto space-y-12">
    <!-- Section Title -->
    <h2 class="text-4xl font-bold text-center md:text-left">Contact Us</h2>

    <!-- Grid Content -->
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <!-- Left Message -->
      <div class="space-y-6">
        <h3 class="text-2xl md:text-3xl font-semibold">
          Let’s Start Your Next Project
        </h3>
        <p class="text-lg leading-relaxed">
          At <strong>Nova Solutions</strong>, based in <strong
            >Albany, NY</strong
          >, we're always here to help you with roofing, gutters, siding, and
          more. Whether you're planning a full remodel or a small repair, we’re
          ready.
        </p>
        <p class="italic text-base text-black">
          “We’re always here to help — inspired by your vision, driven by
          excellence.”
        </p>
      </div>

      <!-- Right Form -->
      <div>
        <FormsServices />
      </div>
    </div>
  </div>
</section>

<Footer />
