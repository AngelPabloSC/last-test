---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";

import BuutonMovil from "../../components/ButtonMovil.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import { LinkServicesSiding } from "../../data/LinkServicesSiding";
---

<Layout
  title="Vinyl Siding Installation in Albany - Nova Solution"
  description="Nova Solution offers expert vinyl siding installation in Albany, Albany. Our team provides affordable, reliable vinyl siding repairs and replacements, including top brands like James Hardie. Call today for a free estimate!"
/>

<SectionInfo heading={"Vinyl Siding"} sliders={suppliers} />

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Siding" class="hover:text-primary">Siding</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Vinyl Siding</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Albany Vinyl Siding
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        Thinking of installing new vinyl siding for your house in the Albany
        area? Our staff at Nova Solution is happy to help you! Our vinyl siding
        installation experts are great craftsmen and cost-effective, and we’ll
        replace your Albany siding just how you hope.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-black">Vinyl Siding Contractor</h2>

    <p class="text-black leading-relaxed text-justify mt-4">
      Our team at Nova Solution of siding experts deliver great siding services
      in Albany. The siding we work with is the longest lasting quality, with
      the most reliable guarantee available today. You will just love how your
      house looks with new siding from our team. It’s not hard to guess why our
      partners rank us five stars as the top-rated siding contractor in Albany.
    </p>

    <p class="text-black leading-relaxed text-justify mt-4">
      Call us today at <strong>(518)-598-5156</strong> to work with a top-rated siding
      installer in Albany.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1747070060/20240522_161015_ftpq6k.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1747069858/imageSiding_qwmkof.png"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        Our Siding Services Include
      </h2>
      <p>
        <ul class="list-disc list-inside text-black space-y-2 mb-1">
          <li>Budget-friendly vinyl siding installation</li>
          <li>Dependable vinyl siding repair</li>
          <li>
            Huge selection of siding available, which includes vinyl and
            insulated siding
          </li>
          <li>Brand-name replacement siding, including James Hardie</li>
        </ul>
      </p>
      <p>
        Let us show you why we're the trusted choice for <strong
          >Siding in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-black mt-4">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices
  title="Related Siding Services"
  services={LinkServicesSiding}
/>
<MoreServices />

<Footer />
