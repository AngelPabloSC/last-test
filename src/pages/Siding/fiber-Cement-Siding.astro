---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import { LinkServicesSiding } from "../../data/LinkServicesSiding";
---

<Layout
  title="Fiber Cement Siding in Albany - Nova Solution"
  description="Upgrade your Albany home with premium James Hardie fiber cement siding from Nova Solution. Expert installation, superior durability, and industry-leading warranties for long-lasting performance and curb appeal."
/>


  <SectionInfo heading={"Fiber Cement Siding for Albany"} sliders={suppliers} />


<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Siding" class="hover:text-primary">Siding</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Fiber Cement Siding</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-xlarge font-bold text-black text-center lg:text-left mt-10">
        James Hardie Board Siding, Albany
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4 text-large">
        If you’re considering new <strong>fiber cement siding</strong>, the
        benefits of <strong>James Hardie Board</strong> are difficult to beat. Our
        team at <strong>Nova Solution</strong> in <strong>Albany</strong> offers
        <strong>Hardie Board siding</strong> installation tailored to your home.
        We trust Hardie Board due to its <strong>great looks</strong>, <strong
          >resilience</strong
        >, and <strong>industry-leading warranties</strong> from James Hardie.
      </p>
      <p class="text-black leading-relaxed mt-4 text-large">
        Count on it, you’re sure to recognize the advantages firsthand! Call us
        at <strong> (518)-598-5156</strong> for a free estimate for <strong
          >James Hardie siding installation</strong
        > for your Albany property!
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-xlarge font-semibold mt-6">Fiber Cement Siding in Albany</h2>
    <p class="text-black leading-relaxed mt-4 text-large">
      Trust our team at <strong>Nova Solution</strong> in Albany — we offer a complete
      range of <strong>James Hardie fiber cement siding</strong> services, including:
    </p>
    <ul class="list-disc list-inside text-black space-y-2 mt-4  text-large">
      <li>
        <strong >Competitively priced Hardie Board siding installation</strong>
      </li>
      <li><strong>Expert James Hardie siding replacement</strong></li>
      <li><strong>Siding repair</strong> including Hardie Board options</li>
      <li><strong>Fiber cement siding</strong> for long-lasting protection</li>
    </ul>
    <p class="text-black leading-relaxed mt-4 text-large">
      All of our <strong>siding installation and replacement</strong> services are
      outstanding, and you’re sure to love the refreshed look of your home with <strong
        >new James Hardie siding</strong
      >.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16 ">
      <h2 class="text-xl font-semibold mt-6 text-xlarge">
        Local Homeowners Pick Hardie Board Siding
      </h2>
      <p class="text-black leading-relaxed mt-4 text-large">
        You will see many advantages to <strong
          >James Hardie Board siding</strong
        >:
      </p>
      <ul class="list-disc list-inside text-black space-y-2 mt-4 text-large">
        <li>
          <strong>Beauty:</strong> Hardie Board is flexible and mimics the look of
          cedar or stone siding. Plus, it can be <strong>repainted</strong> for a
          fresh new look!
        </li>
        <li>
          <strong>Durability:</strong> Ideal for <strong>Albany homes</strong> needing
          <strong>impact and weather resistance</strong>
        </li>
        <li>
          <strong>Warranty:</strong> With expert <strong
            >Hardie Board installers</strong
          > from Nova Solution and James Hardie’s warranty, you can rely on lasting
          quality
        </li>
      </ul>

      <p class="text-black leading-relaxed mt-4 text-large">
        Let us show you why we're the trusted choice for <strong
          >Siding in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-black mt-4 text-large">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-xlarge font-semibold mt-6 text-large">
      Your James Hardie Installers in Albany
    </h2>
    <p class="text-black leading-relaxed mt-4 text-large">
      Whether you need <strong>Hardie Board siding replacement</strong>,
      installation, or repair in <strong>Albany</strong>, we offer the <strong
        >most affordable quotes</strong
      > in the area. Our <strong>reputation for excellence</strong> speaks for itself.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>
<TrustOur />

<RelationServices
  title="Related Siding Services"
  services={LinkServicesSiding}
/>
<MoreServices />

<Footer />
