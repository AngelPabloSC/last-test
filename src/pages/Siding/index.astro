---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";
import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import { LinkServicesSiding } from "../../data/LinkServicesSiding";
---

<Layout
  title="Siding Services in Albany - Nova Solution"
  description="Looking for top-rated siding installation in Albany? Nova Solution provides cost-effective and high-quality siding installation, including vinyl, foam-insulated, and James Hardie Board. Call us for a free estimate today!"
/>

  <SectionInfo heading={"Siding for Albany"} sliders={suppliers} />


<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Siding</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Siding Installation Services in Albany
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        At Nova Solution, we offer professional siding installation in Albany
        for homeowners and businesses. Whether you’re looking for traditional
        vinyl siding, foam-insulated siding, or the increasingly popular fiber
        cement siding (often called James Hardie Board), we have you covered.
        Our siding products come in a wide range of colors and styles to
        complement any property. We ensure expert installation using the proper
        underlayment, keeping your home or business protected for years to come.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-black">
      Top-Rated Siding Contractors in Albany
    </h2>

    <p class="text-black leading-relaxed text-justify mt-4">
      Nova Solution is proud to be a trusted siding company in Albany. We use
      only the best materials and back our work with industry-leading
      warranties. Our expert siding contractors deliver beautiful, durable
      results that homeowners love. That’s why we’re consistently rated 5 stars
      by our satisfied clients.
    </p>

    <p class="text-black leading-relaxed text-justify mt-4">
      Call us today at <strong>(518)-598-5156</strong> to work with a top-rated siding
      installer in Albany.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        Our Siding Services Include
      </h2>
      <p>
        <ul class="list-disc list-inside text-gray-700 space-y-2">
          <li>Cost-effective and high-quality siding installation</li>
          <li>
            Repair for cracked, warped, or rotten siding, soffit, and fascia
          </li>
          <li>A wide variety of siding colors and styles to choose from</li>
          <li>James Hardie siding installation, including Hardie Board</li>
          <li>Premium siding materials from top-rated manufacturers</li>
        </ul>
      </p>
      <p>
        Let us show you why we're the trusted choice for <strong
          >Siding in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-gray-700 mt-4">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>
<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-black">
      Why Choose Nova Solution for Your Siding in Albany?
    </h2>

    <p class="text-black leading-relaxed text-justify mt-4">
      If you're ready for a siding upgrade, Nova Solution is here to help. We
      make the process easy and hassle-free, delivering premium siding that
      improves the look, comfort, and value of your home. Let our experienced
      Albany siding team show you just how smooth and satisfying a siding
      upgrade can be.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>
<TrustOur />

<RelationServices
  title="Related Siding Services"
  services={LinkServicesSiding}
/>
<MoreServices />

<Footer />
