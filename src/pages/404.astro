---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <div
    class="min-h-screen bg-[url('/roof-pattern.svg')] bg-cover bg-center flex items-center justify-center px-4"
  >
    <div
      class="bg-white/80 backdrop-blur-md shadow-2xl rounded-2xl p-10 max-w-xl text-center"
    >
      <iconify-icon
        icon="solar:home-broken-bold-duotone"
        class="text-6xl text-primary mb-4"></iconify-icon>
      <h1 class="text-5xl font-extrabold text-primary mb-2">404</h1>
      <p class="text-lg text-black mb-6">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-block bg-primary text-white px-6 py-3 rounded-xl shadow hover:bg-primary-dark transition"
      >
        ← Back to Home
      </a>
    </div>
  </div>
</Layout>
