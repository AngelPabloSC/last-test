---
import SectionInfo from "../../../components/SectionInfo.astro";
import Layout from "../../../layouts/Layout.astro";
import suppliers from "../../../json/suppliers.json";
import Footer from "../../../components/Footer.astro";
import MoreServices from "../../../components/moreServices.astro";
import RelationServices from "../../../components/relationServices.astro";
import TrustOur from "../../../components/trustOur.astro";
import CertificatesAffiliations from "../../../components/CertificatesAffiliations.astro";
import { LinkServicesGutters } from "../../../data/LinkServicesaRoofingGutters";
---

<Layout
  title="Leaf Filter Installation in Albany | Gutter Protection by Nova Solution"
  description="Protect your home with Nova Solution’s premium leaf filter installation in Albany. Prevent clogs, eliminate maintenance, and extend your gutter system’s life. Contact us today for a free estimate!"
/>

  <SectionInfo heading={"Leaf Filters in Albany"} sliders={suppliers} />


<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Gutters" class="hover:text-primary">Gutter</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <a href="/Gutters/Gutter-Guards" class="hover:text-primary">Gutter Guards</a
    >
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Leaf Filters</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Leaf Filters in Albany
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        <strong
          >Protect your gutters with a reliable leaf filter in Albany</strong
        >. When your gutters stay clean and free of debris, rainwater flows
        safely away from your home — safeguarding your <strong
          >roof, foundation, siding, and landscaping</strong
        >
      </p>

      <p class="text-black leading-relaxed text-justify mt-4">
        At <strong>Nova Solution</strong>, we offer a proprietary <strong
          >leaf filter system</strong
        > designed to block debris from entering your gutters. It’s <strong
          >quick to install</strong
        >, sliding directly over your existing gutters — no messy remodel or
        major construction required.
      </p>
      <p class="text-black leading-relaxed text-justify mt-4">
        Say goodbye to clogged gutters and dangerous cleanups. Contact our team
        today for a free estimate on your leaf filter installation!
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>

  <section
    class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
  >
    <img
      src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
      alt="Certified Roofing Process"
      class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
    />
    <div class="space-y-4">
      <section class="max-w-6xl mx-auto px-4 my-16">
        <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
          Leaf Filter Installers in Albany
        </h2>
        <p class="text-black mb-4">
          Discover the lasting benefits of installing <strong
            >leaf filters</strong
          > with Nova Solution. Say goodbye to climbing ladders and cleaning gutters
          forever! Our team provides expert installation for Albany homeowners seeking
          a clean, clog-free gutter system.
        </p>
        <p class="text-black mb-6">
          Here’s why homeowners across Albany choose Nova Solution:
        </p>
        <ul class="list-disc list-inside text-black space-y-2">
          <li><strong>Say goodbye to gutter cleaning — forever!</strong></li>
          <li>
            <strong>Perfectly fits</strong> with your existing gutter system
          </li>
          <li><strong>Eliminates the need for ongoing maintenance</strong></li>
          <li>
            <strong>All-metal construction</strong> for durability and long-lasting
            performance
          </li>
          <li>
            <strong>Quick installation</strong> — typically done in just 1–2 hours
          </li>
        </ul>
        <p>
          Let us show you why we're the trusted choice for <strong
            >Siding in Albany</strong
          >. Contact us today to schedule your free inspection!
        </p>
        <p class="text-gray-700 mt-4">
          Questions?
          <a href="/About/Contact-us" class="text-black font-bold text-base">
            Contact us
          </a>
          today!
        </p>
      </section>
    </div>
  </section>

  <TrustOur />

  <RelationServices
    title="Related Gutter Services"
    services={LinkServicesGutters}
  />
  <MoreServices />

  <Footer />
</div>
