---
import SectionInfo from "../../../components/SectionInfo.astro";
import Layout from "../../../layouts/Layout.astro";
import suppliers from "../../../json/suppliers.json";
import Footer from "../../../components/Footer.astro";
import MoreServices from "../../../components/moreServices.astro";
import RelationServices from "../../../components/relationServices.astro";
import TrustOur from "../../../components/trustOur.astro";
import CertificatesAffiliations from "../../../components/CertificatesAffiliations.astro";
import { LinkServicesGutters } from "../../../data/LinkServicesaRoofingGutters";
---

<Layout
  title="Gutter Cap Installation - Nova Solution Albany"
  description="Protect your home with maintenance-free gutter caps from Nova Solution in Albany. Stop cleaning clogged gutters and enjoy expert installation today!"
/>

  <SectionInfo heading={"With Gutter Cap"} sliders={suppliers} />

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Gutters/Gutter-Guards" class="hover:text-primary">Gutter</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Gutter-Guards" class="hover:text-primary">Gutter Guards</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Gutter Cap</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Why Choose Gutter Guards from Nova Solution in Albany
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        Tired of cleaning out dirty, clogged gutters? <strong>
          Nova Solution
        </strong> offers top-of-the-line gutter guards that eliminate debris build-up
        and protect your home from water damage — all with zero maintenance. Our
        expert team in Albany <strong>provides fast </strong>, affordable
        installation using the most effective and durable systems available on
        the market.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-black">
      Trusted Gutter guard Installers in Greater Albany
    </h2>

    <p class="text-black leading-relaxed text-justify mt-4">
      Say goodbye to clogged gutters and constant maintenance. At <strong
        >Nova Solution</strong
      >, our gutter guard systems are designed for performance and built to
      last. Whether you’re upgrading or protecting a new system, <strong
        >our expert installers in Albany</strong
      > ensure a seamless fit and fast service — all at a price you’ll love.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        Our Gutter Services Include
      </h2>
      <p>
        <ul class="list-disc list-inside text-black space-y-3 mb-10">
          <li>
            <strong>No more cleaning</strong> — enjoy maintenance-free gutters all
            year
          </li>
          <li>
            <strong>Protect your home from water damage</strong> with efficient flow
            control
          </li>
          <li>
            <strong>Quick, professional installation</strong> means less disruption
            and lower cost
          </li>
          <li>
            <strong>Custom-fit solutions</strong> that blend perfectly with your
            home’s exterior
          </li>
          <li>
            <strong>All-metal construction</strong> for long-lasting performance
            and durability
          </li>
        </ul>
      </p>
      <p>
        Let us show you why we're the trusted choice for <strong
          >Gutter Guards in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-gray-700 mt-4">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices
  title="Related Gutter Services"
  services={LinkServicesGutters}
/>
<MoreServices />

<Footer />
