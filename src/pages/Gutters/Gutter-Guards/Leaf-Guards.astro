---
import SectionInfo from "../../../components/SectionInfo.astro";
import Layout from "../../../layouts/Layout.astro";
import suppliers from "../../../json/suppliers.json";
import Footer from "../../../components/Footer.astro";
import BuutonMovil from "../../../components/ButtonMovil.astro";
import MoreServices from "../../../components/moreServices.astro";
import RelationServices from "../../../components/relationServices.astro";
import TrustOur from "../../../components/trustOur.astro";
import CertificatesAffiliations from "../../../components/CertificatesAffiliations.astro";
import { LinkServicesGutters } from "../../../data/LinkServicesaRoofingGutters";
---

<Layout
  title="Leaf Guards in Albany | Gutter Protection by Nova Solution"
  description="Prevent clogs and protect your home with custom leaf guard installation in Albany. Nova Solution offers durable, all-metal gutter guards with free estimates and expert service."
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[130px] md:mt-[95px]">
  <SectionInfo heading={"Leaf Guards in Albany"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Gutters" class="hover:text-primary">Gutter</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <a href="/Gutters/Gutter-Guards" class="hover:text-primary">Gutter Guards</a
    >
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Leaf Guards</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Albany Leaf Guards for Your Home
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        <strong>Upgrade your gutters with high-quality leaf guards</strong> from
        Nova Solutions in Albany. Gutters are essential to protect your home, foundation,
        and landscaping from rainwater erosion. Without protection, leaves and debris
        can cause serious clogs and blockages that lead to water damage.
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>

  <section
    class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
  >
    <img
      src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
      alt="Certified Roofing Process"
      class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
    />
    <div class="space-y-4">
      <section class="max-w-6xl mx-auto px-4 my-16">
        <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
          Albany’s Trusted Leaf Guard Experts
        </h2>
        <p class="text-black mb-4">
          When it’s time to upgrade your gutters with reliable leaf guards, <strong
            >Nova Solutions is your go-to team in Albany</strong
          > and the surrounding areas. We value your trust and want you to know exactly
          why homeowners across Albany choose us for gutter protection.
        </p>
        <p class="text-black mb-6">
          Here’s what you can expect when you work with <strong
            >Nova Solutions for your leaf guard installation</strong
          >:
        </p>
        <ul class="list-disc list-inside text-black space-y-2 mb-10">
          <li>
            <strong>Free estimates</strong> with honest, affordable pricing
          </li>
          <li>
            <strong>All-metal construction</strong> for maximum durability and strength
          </li>
          <li>
            <strong>Top-rated service</strong> from skilled, local experts
          </li>
          <li>
            <strong>100% customer satisfaction</strong> — just check out our reviews!
          </li>
          <li>
            <strong>Custom-built leaf guards</strong> that perfectly fit your home’s
            design
          </li>
        </ul>
        <p>
          Let us show you why we're the trusted choice for <strong
            >Leaf Guards in Albany</strong
          >. Contact us today to schedule your free inspection!
        </p>
        <p class="text-gray-700 mt-4">
          Questions?
          <a href="/About/Contact-us" class="text-black font-bold text-base">
            Contact us
          </a>
          today!
        </p>
      </section>
    </div>
  </section>

  <TrustOur />

  <RelationServices
    title="Related Gutter Services"
    services={LinkServicesGutters}
  />
  <MoreServices />

  <Footer />
</div>
