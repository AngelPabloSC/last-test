---
import SectionInfo from "../../../components/SectionInfo.astro";
import Layout from "../../../layouts/Layout.astro";
import suppliers from "../../../json/suppliers.json";
import Footer from "../../../components/Footer.astro";
import BuutonMovil from "../../../components/ButtonMovil.astro";
import MoreServices from "../../../components/moreServices.astro";
import RelationServices from "../../../components/relationServices.astro";
import TrustOur from "../../../components/trustOur.astro";
import CertificatesAffiliations from "../../../components/CertificatesAffiliations.astro";
import { LinkServicesGutters } from "../../../data/LinkServicesaRoofingGutters";
---

<Layout
  title="Gutter Protection in Albany | Nova Solution"
  description="Protect your home with Nova Solution’s expert gutter protection installation in Albany. Say goodbye to clogged gutters and hello to low-maintenance, high-performance gutter systems. Contact us for a free estimate!"
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[172px] md:mt-[95px]">
  <SectionInfo heading={"Gutter Protection"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Gutters" class="hover:text-primary">Gutter</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <a href="/Gutters/Gutter-Guards" class="hover:text-primary">Gutter Guards</a
    >
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Gutter Protection</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Gutter Protection in Albany
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        <strong>Meet Your New Gutter Protection System</strong> — the smartest investment
        for long-term gutter performance. With <strong
          >Nova Solution’s custom gutter protection</strong
        >, your gutters will be shielded from debris, clogs, and unnecessary
        maintenance, helping you protect your home and save time.
      </p>

      <p class="text-black leading-relaxed text-justify mt-4">
        Our system offers <strong>fast installation</strong> and <strong
          >lasting durability</strong
        >. In just one day, we can install high-quality, custom-fit gutter
        covers over your existing gutters. Say goodbye to constant cleaning and
        dirty repair jobs — and hello to <strong
          >worry-free gutter protection in Albany</strong
        >
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>

  <section
    class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
  >
    <div class="space-y-4">
      <h2 class="text-2xl font-bold text-black">
        Gutter Protection Installation in Albany
      </h2>

      <p class="text-black leading-relaxed text-justify mt-4">
        <strong>Protecting your gutters</strong> means keeping them free from leaves,
        debris, and buildup that can cause clogs and damage. By installing our <strong
          >professional gutter protection system</strong
        >, you extend the lifespan of your gutters and help prevent water damage
        to your roofline, foundation, and landscaping.
      </p>
      <p class="text-black leading-relaxed text-justify mt-4">
        Trust <strong>Nova Solution</strong> — Albany’s reliable choice for <strong
          >expert gutter protection installation</strong
        >. Our experienced team has completed countless projects across the
        area, and we’re ready to safeguard your home next.
      </p>
    </div>
    <img
      src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
      alt="Roofing Installation"
      class="rounded-xl shadow-lg w-full max-w-md mx-auto"
    />
  </section>

  <section
    class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
  >
    <img
      src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
      alt="Certified Roofing Process"
      class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
    />
    <div class="space-y-4">
      <section class="max-w-6xl mx-auto px-4 my-16">
        <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
          Why Gutter Protection?
        </h2>
        <p class="text-black mb-4">
          Gutter protection may seem optional — until you’re dealing with the
          mess and damage caused by clogged gutters. At <strong
            >Nova Solution</strong
          >, we provide trusted <strong
            >gutter protection systems in Albany</strong
          > that save you time, money, and hassle.
        </p>
        <p class="text-black mb-6">
          Here’s why homeowners across Albany choose Nova Solution:
        </p>
        <ul class="list-disc list-inside text-black space-y-2">
          <li>
            <strong>Simple, transparent pricing</strong> with no hidden fees
          </li>
          <li>
            <strong>Custom-fit gutter guards</strong> designed specifically for your
            home
          </li>
          <li><strong>Flexible scheduling</strong> to fit your availability</li>
          <li>
            <strong>Fast, courteous installation</strong> by our expert team
          </li>
          <li>
            <strong>Seamless style and performance</strong> — built to match your
            exterior
          </li>
        </ul>
        <p>
          Let us show you why we're the trusted choice for <strong
            >Siding in Albany</strong
          >. Contact us today to schedule your free inspection!
        </p>
        <p class="text-gray-700 mt-4">
          Questions?
          <a href="/About/Contact-us" class="text-black font-bold text-base">
            Contact us
          </a>
          today!
        </p>
      </section>
    </div>
  </section>

  <TrustOur />

  <RelationServices
    title="Related Gutter Services"
    services={LinkServicesGutters}
  />
  <MoreServices />

  <Footer />
</div>
