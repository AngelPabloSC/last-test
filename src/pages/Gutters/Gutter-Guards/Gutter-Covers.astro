---
import SectionInfo from "../../../components/SectionInfo.astro";
import Layout from "../../../layouts/Layout.astro";
import suppliers from "../../../json/suppliers.json";
import Footer from "../../../components/Footer.astro";
import BuutonMovil from "../../../components/ButtonMovil.astro";
import MoreServices from "../../../components/moreServices.astro";
import RelationServices from "../../../components/relationServices.astro";
import TrustOur from "../../../components/trustOur.astro";
import CertificatesAffiliations from "../../../components/CertificatesAffiliations.astro";
import { LinkServicesGutters } from "../../../data/LinkServicesaRoofingGutters";
---

<Layout
  title="Gutter Covers Installation - Premium Protection by Nova Solution in Albany"
  description="Protect your home with high-quality gutter covers from Nova Solution in Albany. Our professional installation ensures clean, clog-free gutters all year round. Contact us today for a free quote!"
/>
<BuutonMovil class="fixed bottom-4 right-4 z-50" />
<div class="mt-[172px] md:mt-[95px]">
  <SectionInfo heading={"Gutter Covers"} sliders={suppliers} />
</div>

<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>

    <a href="/Gutters" class="hover:text-primary">Gutter</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <a href="/Gutters/Gutter-Guards" class="hover:text-primary">
      Gutter Covers</a
    >
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Gutter Covers</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Albany Gutter Covers – Optimize Your Gutters with Lasting Protection
      </h1>

      <p class="text-black leading-relaxed text-justify mt-4">
        Tired of overflowing gutters every time it rains? Or spotting weeds
        sprouting in your gutters each spring? You’re not alone. Many Albany
        homeowners want spotless, low-maintenance gutters—and <strong
          >Nova Solutions has the answer</strong
        >.
      </p>

      <p class="text-black leading-relaxed text-justify mt-4">
        <strong>Gutter covers</strong> are a smart gutter protection system that
        installs easily over your existing gutters. They filter out debris before
        it ever enters the system, keeping water flowing freely—no more seasonal
        cleanups!
      </p>

      <p class="text-black leading-relaxed text-justify mt-4">
        Want to learn more about how <strong
          >Nova Solutions can protect your home with premium gutter covers in
          Albany</strong
        >? Call our experts today or fill out our quick online form to get
        started with a free quote!
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
  <section
    class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
  >
    <div class="space-y-4">
      <h2 class="text-2xl font-bold text-black">
        Albany’s Trusted Gutter Cover Installers
      </h2>

      <p class="text-black leading-relaxed text-justify mt-4">
        Why do so many homeowners in Albany choose <strong
          >Nova Solutions</strong
        > for their gutter cover installation? It's simple — your home deserves reliable,
        efficient service from a team that truly cares.
      </p>

      <p class="text-black leading-relaxed text-justify mt-4">
        At Nova Solutions, we’ve built a trusted reputation across Albany for
        delivering <strong>fast, expert gutter solutions</strong>. From first
        call to final installation, our team ensures your gutter cover system is
        installed with precision and professionalism.
      </p>
      <p class="text-black leading-relaxed text-justify mt-4">
        Whether you're protecting your home from clogs or simply reducing the
        need for seasonal cleanups, our <strong
          >Albany gutter cover specialists</strong
        > are here to help with customized service tailored to your home.
      </p>
    </div>
    <img
      src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
      alt="Roofing Installation"
      class="rounded-xl shadow-lg w-full max-w-md mx-auto"
    />
  </section>
</div>
<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />
  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        What You Can Expect from Our Albany Gutter Cover Installers
      </h2>

      <ul class="list-disc list-inside text-black space-y-2 mb-10">
        <li>
          <strong>Affordable solutions</strong> – Our honest pricing means no surprises,
          just value-driven gutter cover installation.
        </li>
        <li>
          <strong>Fast, non-invasive installation</strong> – We work quickly and
          cleanly to protect your home with minimal disruption.
        </li>
        <li>
          <strong>Durable, all-metal gutter covers</strong> – Built to last, our
          covers are crafted from premium-quality metal.
        </li>
        <li>
          <strong>Made in the USA</strong> – We’re proud to install American-made
          products built for local weather conditions.
        </li>
        <li>
          <strong>Customer-first service</strong> – Your satisfaction is our priority
          from the first consultation to final inspection.
        </li>
      </ul>
      <p>
        Let us show you why we're the trusted choice for <strong
          >Gutter Covers in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-black mt-4">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices
  title="Related Gutter Services"
  services={LinkServicesGutters}
/>
<MoreServices />

<Footer />
