---
import SectionInfo from "../../components/SectionInfo.astro";
import Layout from "../../layouts/Layout.astro";
import suppliers from "../../json/suppliers.json";
import Footer from "../../components/Footer.astro";

import MoreServices from "../../components/moreServices.astro";
import RelationServices from "../../components/relationServices.astro";
import TrustOur from "../../components/trustOur.astro";
import CertificatesAffiliations from "../../components/CertificatesAffiliations.astro";
import { LinkServicesGutters } from "../../data/LinkServicesaRoofingGutters";
---

<Layout
  title="Gutter Replacement & Repair in Albany | Nova Solution"
  description="Protect your home in Albany with expert gutter replacement and repair by Nova Solution. We install seamless, aluminum, and vinyl gutters with gutter guard options to prevent clogs. Get a free estimate from Albany’s trusted gutter professionals today!"
/>

  <SectionInfo heading={"Gutter Replacement"} sliders={suppliers} />


<div class="max-w-6xl mx-auto px-4 my-16">
  <div class="breadcrumb text-sm text-gray-600 flex items-center">
    <a href="/" class="hover:text-primary">Home</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <a href="/Gutters" class="hover:text-primary">Gutters</a>
    <iconify-icon
      icon="mingcute:arrows-right-line"
      class="mx-2 text-gray-400 text-lg"></iconify-icon>
    <span class="font-semibold text-black">Gutter Replacement</span>
  </div>

  <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
    <div class="flex-1 space-y-6">
      <h1 class="text-3xl font-bold text-black text-center lg:text-left mt-10">
        Gutter Replacement in Albany
      </h1>

      <p class="text-black mb-4">
        If your gutters are damaged, outdated, or just not performing like they
        should, call the experts at <strong>Nova Solution</strong>! With <strong
          >over 20 years of experience</strong
        >, our team specializes in seamless gutter replacement for homes in
        Albany and surrounding areas. We don't just replace gutters — <strong
          >we upgrade them</strong
        > for better durability, drainage, and curb appeal.
      </p>

      <p class="text-black mb-4">
        Our skilled professionals are known for <strong
          >5-star quality service</strong
        > and expert craftsmanship. We’ll make your new gutters look better than
        ever.
      </p>

      <p class="text-black mt-4">
        <strong
          >Call us today at
          <a href="tel:5185985156" class="text-black font-bold"
            >(518)-598-5156</a
          >
        </strong>
        for top-rated gutter replacement in Albany!
      </p>
    </div>
    <section class="flex-1 text-black mt-10">
      <CertificatesAffiliations />
    </section>
  </div>
</div>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-black">When to Replace Your Gutters</h2>

    <p class="text-black leading-relaxed text-justify mt-4">
      You might be wondering, <strong
        >"Should I repair or replace my gutters?"</strong
      > There are a few clear signs that can help you decide. Paying attention to
      these early indicators can save you from bigger and more expensive issues down
      the line.
    </p>
    <p class="text-black leading-relaxed text-justify mt-4">
      If you're noticing persistent leaks, sagging sections, rust, or gutters
      pulling away from the roofline — it’s time to consider a <strong
        >professional gutter replacement</strong
      >. At <strong>Nova Solution in Albany</strong>, we're here to inspect and
      recommend the best solution for your home.
    </p>
  </div>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1744940052/20231124_164824_pbq8zx.jpg"
    alt="Roofing Installation"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto"
  />
</section>

<section
  class="max-w-6xl mx-auto px-4 my-16 grid md:grid-cols-2 gap-8 items-center"
>
  <img
    src="https://res.cloudinary.com/driyxelzh/image/upload/v1745296100/GAF-Layer-lock-Dynamic-Restoration_hodwla.jpg"
    alt="Certified Roofing Process"
    class="rounded-xl shadow-lg w-full max-w-md mx-auto order-1 md:order-none"
  />



  <div class="space-y-4">
    <section class="max-w-6xl mx-auto px-4 my-16">
      <h2 class="text-2xl font-bold text-black mb-4 text-center lg:text-left">
        Our Gutter Services Include
      </h2>
      <p>
        <ul class="list-disc list-inside text-black space-y-2">
          <li>
            <strong>Severe leakage</strong>: If multiple areas are leaking, full
            gutter replacement is often more affordable and effective than
            patching in the long term.
          </li>
          <li>
            <strong>Corrosion issues</strong>: Whether it’s rust on gutters,
            downspouts, or gutter hangers, we’ll address the problem before it
            spreads. Don’t let rust damage your home!
          </li>
          <li>
            <strong>Wind damage</strong>: If your gutters are dented, warped, or
            decayed after a storm, it’s time to act. Replacing damaged gutters
            prevents water from pooling and causing further harm.
          </li>
        </ul>
      </p>
      <p>
        Let us show you why we're the trusted choice for <strong
          >Gutter in Albany</strong
        >. Contact us today to schedule your free inspection!
      </p>
      <p class="text-gray-700 mt-4">
        Questions?
        <a href="/About/Contact-us" class="text-black font-bold text-base">
          Contact us
        </a>
        today!
      </p>
    </section>
  </div>
</section>

<TrustOur />

<RelationServices
  title="Related Gutters Services"
  services={LinkServicesGutters}
/>
<MoreServices />

<Footer />
