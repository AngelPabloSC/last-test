---
interface LayoutProps {
  title: string;
  description: string;
  keywords: string;
}
const { title, description, keywords } = Astro.props;
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Nova Solutions" />
    <meta property="og:site_name" content="Nova Solutions" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:type" content="article" />
    <meta property="article:author" content="https://novasolutions.com/About" />
    <meta property="article:published_time" content="2025-05-05T10:00:00Z" />
    <meta property="article:modified_time" content="2025-05-05T12:30:00Z" />
    <meta property="article:expiration_time" content="2025-12-31T23:59:59Z" />
    <meta property="article:section" content="Roofing Services" />
    <meta property="article:tag" content="roofing, masonry, renovation" />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="315" />

    <meta
      property="og:url"
      content="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />
    <meta name="twitter:image:alt" content="Nova Solutions company logo" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />

    <link
      rel="apple-touch-icon"
      href="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
      sizes="180x180"
    />

    <link
      rel="apple-touch-icon-precomposed"
      href="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
      sizes="180x180"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />

    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>

  <body>
    <Header />
    <slot />

    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"
    ></script>
    <script
      src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"
    ></script>
  </body>
</html>
