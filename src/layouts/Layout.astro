---
interface LayoutProps {
  title: string;
  description: string;
  keywords: string;
  showButtonMovil: boolean;
}
const { title, description, keywords, showButtonMovil = true } = Astro.props;
import Accessibility from "../components/common/Accessibility.astro";
import Header from "../components/layout/Header.astro";
import BuutonMovil from "../components/ui/ButtonMovil.astro";
import "../styles/global.css";

import AzonixFont from "../assets/fonts/Azonix.otf";
import FutrfwFont from "../assets/fonts/FUTRFW.TTF";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://code.iconify.design">
    
    <link
      rel="icon"
      type="image/png"
      href="https://res.cloudinary.com/driyxelzh/image/upload/w_96,h_96,f_auto,q_auto/v1758224762/para_fondos_obscuros_eyaupu.png"
    />
    <link 
      rel="preload" 
      as="image" 
      href="https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1746726907/IMG-20240109-WA0138_y93nsn.jpg"
      imagesrcset="
        https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_800/v1746726907/IMG-20240109-WA0138_y93nsn.jpg 800w,
        https://res.cloudinary.com/driyxelzh/image/upload/f_auto,q_auto,c_scale,w_1920/v1746726907/IMG-20240109-WA0138_y93nsn.jpg 1920w
      "
      imagesizes="(max-width: 768px) 800px, 1920px"
      fetchpriority="high"
    />
    <link rel="preload" href={AzonixFont} as="font" type="font/otf" crossorigin />
    <link rel="preload" href={FutrfwFont} as="font" type="font/ttf" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Nova Solutions" />
    <meta property="og:site_name" content="Nova Solutions" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="canonical" href="https://nova-solutions.us" />
    <meta name="application-name" content="Nova Solutions Restoration" />
    <meta name="robots" content="index, follow" />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/driyxelzh/image/upload/w_1200,h_630,f_auto,q_auto,c_fill/v1758224762/para_fondos_obscuros_eyaupu.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:url"
      content="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />

    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />
    <meta name="twitter:image:alt" content="Nova Solutions company logo" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="42x42" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="42x42" />

    
    <link
      rel="apple-touch-icon"
      href="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
      sizes="180x180"
    />

    <link
      rel="apple-touch-icon-precomposed"
      href="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
      sizes="180x180"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
      media="print" 
      onload="this.media='all'"
    />

    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <Accessibility />
  <body>
    <Header />

    <slot />
    {showButtonMovil && <BuutonMovil class="fixed bottom-4 right-4 z-50" />}
    <script
      src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"
      defer
    ></script>
  </body>
</html>
