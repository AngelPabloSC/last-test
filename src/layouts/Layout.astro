---
interface LayoutProps {
  title: string;
  description: string;
  keywords: string;
  showButtonMovil: boolean;
}
const { title, description, keywords, showButtonMovil = true } = Astro.props;
import Accessibility from "../components/Accessibility.astro";
import Header from "../components/Header.astro";
import BuutonMovil from "../components/ButtonMovil.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href="https://res.cloudinary.com/driyxelzh/image/upload/v1744257843/WhatsApp_Image_2025-04-04_at_12.54.27-removebg-preview_vnwtwg.png"
    />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Nova Solutions" />
    <meta property="og:site_name" content="Nova Solutions" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:type" content="article" />

    <link rel="canonical" href="https://nova-solutions.us" />
    <meta name="application-name" content="Nova Solutions Restoration" />
    <meta name="robots" content="index, follow" />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/driyxelzh/image/upload/c_pad,b_white,w_1200,h_630/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:url"
      content="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
    />
    <meta name="twitter:image:alt" content="Nova Solutions company logo" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />

    <link
      rel="apple-touch-icon"
      href="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
      sizes="180x180"
    />

    <link
      rel="apple-touch-icon-precomposed"
      href="https://res.cloudinary.com/driyxelzh/image/upload/v1746592837/NOVA_Mesa_de_trabajo_1_fwplz7.png"
      sizes="180x180"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />

    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <Accessibility />
  <body>
    <Header />

    <slot />
    {showButtonMovil && <BuutonMovil class="fixed bottom-4 right-4 z-50" />}
    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"
    ></script>
    <script
      src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"
    ></script>
  </body>
</html>
